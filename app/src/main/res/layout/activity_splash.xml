<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F9FD">

        <View
            android:id="@+id/orbTop"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginStart="-84dp"
            android:layout_marginTop="-58dp"
            android:alpha="0.9"
            android:background="#D8EEF7" />

        <View
            android:id="@+id/orbRight"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="116dp"
            android:layout_marginEnd="-70dp"
            android:alpha="0.95"
            android:background="#FFECCB" />

        <View
            android:id="@+id/orbBottom"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="-56dp"
            android:layout_marginBottom="72dp"
            android:alpha="0.7"
            android:background="#E4F5E9" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/_20sdp"
            android:paddingTop="@dimen/_24sdp"
            android:paddingEnd="@dimen/_20sdp"
            android:paddingBottom="@dimen/_20sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/topBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8F4FF"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="Smart Cleanup"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_11ssp"
                app:fontFamily="@font/roboto_medium" />

            <RelativeLayout
                android:id="@+id/headerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:layout_weight="1">

                <androidx.cardview.widget.CardView
                    android:id="@+id/logoCard"
                    android:layout_width="@dimen/_220sdp"
                    android:layout_height="@dimen/_220sdp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/_16sdp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/_36sdp"
                    app:cardElevation="@dimen/_10sdp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#F8FBFF" />

                        <View
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:alpha="0.85"
                            android:background="#EAF5FD" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/appIcon"
                            android:layout_width="@dimen/_132sdp"
                            android:layout_height="@dimen/_132sdp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/splash_logo_icon" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/appTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/logoCard"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/app_name"
                    android:textColor="@color/black_text_color"
                    android:textSize="@dimen/_30ssp"
                    app:fontFamily="@font/pop_regular" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/tagCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    app:cardBackgroundColor="#FDFEFF"
                    app:cardCornerRadius="@dimen/_22sdp"
                    app:cardElevation="@dimen/_4sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_16sdp"
                        android:paddingTop="@dimen/_16sdp"
                        android:paddingEnd="@dimen/_16sdp"
                        android:paddingBottom="@dimen/_16sdp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/appTag"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/app_sub_title"
                            android:textColor="#60758C"
                            android:textSize="@dimen/_13ssp"
                            android:visibility="visible"
                            app:fontFamily="@font/pop_regular" />

                        <LinearLayout
                            android:id="@+id/featureRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_14sdp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#EEF7FF"
                                android:paddingStart="10dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="6dp"
                                android:text="Fast"
                                android:textColor="@color/black_text_color"
                                android:textSize="@dimen/_10ssp"
                                app:fontFamily="@font/roboto_medium" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="#F2FAF4"
                                android:paddingStart="10dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="6dp"
                                android:text="Private"
                                android:textColor="#2C8C5B"
                                android:textSize="@dimen/_10ssp"
                                app:fontFamily="@font/roboto_medium" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="#FFF6E9"
                                android:paddingStart="10dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="6dp"
                                android:text="Secure"
                                android:textColor="#BD7A1E"
                                android:textSize="@dimen/_10ssp"
                                app:fontFamily="@font/roboto_medium" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/footerTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingBottom="@dimen/_16sdp"
            android:text="@string/copyrights_msg"
            android:textColor="#7B8B9C"
            android:textSize="@dimen/_10ssp"
            app:fontFamily="@font/roboto_medium" />

    </RelativeLayout>
</layout>
