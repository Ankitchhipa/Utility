<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grey_white_bg_gradient"
    tools:context=".activity.SettingsMainActivity">

    <include
        android:id="@+id/mToolbar"
        layout="@layout/main_toolbar" />

    <RelativeLayout
        android:id="@+id/rl_storage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_15sdp"
        android:background="@drawable/round_corner_shape"
        android:elevation="@dimen/_4sdp"
        android:outlineAmbientShadowColor="@color/blue_shadow"
        android:outlineSpotShadowColor="@color/blue_shadow"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mToolbar">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_storage"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_storage" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iv_storage"
            android:text="@string/storage_access"
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp"
            app:fontFamily="@font/roboto_medium" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_sub_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_storage"
            android:layout_toEndOf="@id/iv_storage"
            android:text="@string/allow_usage_data_access"
            android:textColor="@color/grey"
            android:textSize="@dimen/_10ssp"
            app:fontFamily="@font/roboto_regular" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>