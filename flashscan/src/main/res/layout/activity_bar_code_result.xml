<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_color"
        android:orientation="vertical">

        <!--<include layout="@layout/common_toolbar" />-->
        <include layout="@layout/home_toolbar" />

        <FrameLayout
            android:id="@+id/ad_view_banner_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white" >

            <include layout="@layout/adaptive_banner_ad_layout" />

        </FrameLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            card_view:cardBackgroundColor="@android:color/white"
            card_view:cardCornerRadius="10dp"
            card_view:cardElevation="5dp"
            card_view:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:paddingBottom="@dimen/_5sdp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_tick"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center_horizontal"
                        card_view:srcCompat="@drawable/animated_check" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/detect_code_successfully"
                        android:textColor="#66687A"
                        android:textSize="16sp"
                        app:fontFamily="@font/roboto_medium" />

                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center"
                        android:textColor="#686C6D"
                        android:textSize="14sp"
                        app:fontFamily="@font/roboto_regular"
                        tools:text="22nd April 2020, 11:45 PM" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="@string/recognization_result"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        app:fontFamily="@font/roboto_medium" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_solid_blue"
                        android:fadeScrollbars="false"
                        android:fillViewport="true"
                        android:scrollbars="vertical">

                        <TextView
                            android:id="@+id/tv_result_bar_code"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="left|center_vertical"
                            android:lineSpacingExtra="2dp"
                            android:padding="15dp"
                            android:textColor="@color/sky_blue"
                            android:textSize="14sp"
                            app:fontFamily="@font/roboto_regular"
                            tools:text="https://www.google.com/search?q=qr+code+ scanner&amp;safe=active&amp;rlz=1C1CHB" />
                    </ScrollView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <Button
                            android:id="@+id/btn_open_result"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:layout_marginVertical="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/button_bg"
                            android:textAllCaps="false"
                            android:textColor="@color/sky_blue"
                            android:textSize="14sp"
                            app:fontFamily="@font/roboto_medium"
                            tools:text="@string/open_url" />

                        <Button
                            android:id="@+id/btn_open_result_other"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_bg"
                            android:textAllCaps="false"
                            android:textColor="@color/sky_blue"
                            android:textSize="14sp"
                            android:visibility="gone"
                            tools:text="@string/open_url" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include layout="@layout/bar_code_bottom_bar" />
    </LinearLayout>

</FrameLayout>