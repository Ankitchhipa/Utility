<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_4sdp">

        <ImageView
            android:id="@+id/tvad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_ad_badge"
            android:layout_marginStart="@dimen/_5sdp"/>
       <!-- <TextView
            android:id="@+id/tvad"
            android:layout_width="wrap_content"
            android:text="@string/str_ad"
            android:background="@color/grayseperator"
            android:textColor="@color/white"
            android:paddingLeft="@dimen/margin_2"
            android:paddingRight="@dimen/margin_2"
            android:paddingTop="@dimen/margin_1"
            android:textSize="@dimen/font_11"
            android:paddingBottom="@dimen/margin_1"
            android:layout_height="wrap_content" />-->

        <LinearLayout
            android:id="@+id/top_container"
            android:orientation="horizontal"
            android:layout_below="@id/tvad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5sdp">

            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="@dimen/margin_60"
                android:layout_height="@dimen/margin_60"
                android:adjustViewBounds="true"
                android:layout_marginEnd="@dimen/_8sdp"
                />

            <LinearLayout
                android:id="@+id/ll_details"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/margin_8">

                <TextView
                    android:id="@+id/ad_headline"
                    android:text="@string/app_name"
                    android:textStyle="bold"
                    android:textSize="@dimen/font_14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:gravity="center_vertical"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/ad_advertiser"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:textStyle="bold"
                        android:textSize="@dimen/font_12"/>

                    <RatingBar
                        android:id="@+id/ad_stars"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:isIndicator="true"
                        android:numStars="5"
                        android:stepSize="0.5" />

                </LinearLayout>

                <TextView
                    android:id="@+id/ad_store"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingRight="5dp"
                    android:paddingEnd="5dp"
                    android:textSize="12sp"
                    android:drawablePadding="@dimen/margin_5"
                    android:drawableLeft="@drawable/google_play_icon"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/ad_body"
            android:layout_below="@id/top_container"
            android:text="@string/app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:visibility="gone"/>

        <com.google.android.gms.ads.formats.MediaView
            android:id="@+id/ad_media"
            android:layout_below="@id/ad_body"
            android:layout_gravity="center_horizontal"
            android:layout_width="220dp"
            android:layout_centerHorizontal="true"
            android:layout_height="154dp"
            android:layout_marginTop="@dimen/margin_5"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_below="@id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
           >

            <TextView
                android:id="@+id/ad_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="5dp"
                android:paddingStart="5dp"
                android:paddingRight="5dp"
                android:paddingEnd="5dp"
                android:textSize="12sp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/ad_call_to_action"
                android:paddingLeft="@dimen/margin_15"
                android:paddingRight="@dimen/margin_15"
                android:paddingTop="@dimen/margin_5"
                android:paddingBottom="@dimen/margin_5"
                android:layout_marginHorizontal="@dimen/_3sdp"
                android:textColor="@color/sky_blue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_bg"
                android:gravity="center"
                android:text=""
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
