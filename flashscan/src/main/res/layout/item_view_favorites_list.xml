<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_80sdp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="@dimen/_10sdp"
    android:layout_marginTop="@dimen/_10sdp"
    android:layout_marginBottom="@dimen/_10sdp"
    android:background="@drawable/bg_round_rect_white"
    android:elevation="@dimen/_2sdp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/_4sdp">


    <FrameLayout
        android:layout_width="90dp"
        android:layout_height="90dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            card_view:cardBackgroundColor="@android:color/white"
            card_view:cardCornerRadius="20dp"
            card_view:cardElevation="2dp"
            card_view:cardUseCompatPadding="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_doc"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/ic_loading" />


        </androidx.cardview.widget.CardView>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/fl_star"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:padding="@dimen/_5sdp"
            android:layout_gravity="end"
            android:layout_marginHorizontal="@dimen/_2sdp"
            android:background="@drawable/round"
            app:shapeAppearance="@style/roundedImageViewRounded"
            android:src="@drawable/ic_btn_fav_rad"
            app:contentPadding="@dimen/_4sdp"
            android:elevation="@dimen/_3sdp"
            />

        <TextView
            android:id="@+id/tv_view_more"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:background="@drawable/bg_dashed_rectangle"
            android:gravity="center"
            android:text="@string/view_more"
            android:textColor="@color/sky_blue"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_doc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingLeft="5dp"
        android:textColor="#353535"
        android:textSize="@dimen/_9ssp"
        tools:text="Aadhar Cards dsbdbshdbshdbshdbshdbsh" />

    <TextView
        android:id="@+id/tv_date_doc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:paddingLeft="5dp"
        android:textColor="#929292"
        android:textSize="@dimen/_8ssp"
        tools:text="08/03/2020" />

</LinearLayout>