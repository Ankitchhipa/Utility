<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_no_doc_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/no_scanned_documents"
        android:textColor="@color/black_text_color"
        android:textSize="16sp"
        app:fontFamily="@font/roboto_medium" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/fl_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:elevation="5dp"
            android:layout_margin="@dimen/_10sdp"
            android:background="@drawable/bg_blue_circle">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:scaleX="1.2"
                android:scaleY="1.2"
                android:tint="@color/black_text_color"
                app:srcCompat="@drawable/ic_camera" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fl_media"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:elevation="@dimen/_5sdp"
            android:layout_margin="@dimen/_10sdp"
            android:background="@drawable/bg_blue_circle">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:scaleX="1.2"
                android:scaleY="1.2"
                android:tint="@color/black_text_color"
                app:srcCompat="@drawable/ic_media" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_no_doc_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/scan_now_msg"
        android:textColor="@color/black_text_color"
        android:textSize="12sp"
        app:fontFamily="@font/roboto_regular" />

</LinearLayout>