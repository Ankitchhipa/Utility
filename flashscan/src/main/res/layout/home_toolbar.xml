<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_50sdp"
    android:background="@color/toolbar_color">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:padding="12dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_menu" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_25sdp"
        android:layout_gravity="center_vertical"
        android:padding="@dimen/_2sdp"
        android:layout_marginStart="@dimen/_7sdp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_arrow_new" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_home"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_25sdp"
        android:layout_gravity="center_vertical"
        android:padding="@dimen/_2sdp"
        android:layout_marginStart="@dimen/_7sdp"
        app:srcCompat="@drawable/ic_arrow_new" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/_7sdp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="@string/document_scanner"
            android:textColor="@color/black_text_color"
            android:textSize="@dimen/_12ssp"
            app:fontFamily="@font/pop_light" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:hint="@string/search"
            android:paddingVertical="@dimen/_8sdp"
            android:background="@drawable/edit_text_bg"
            android:imeOptions="actionGo"
            android:includeFontPadding="false"
            android:inputType="text"
            android:paddingHorizontal="@dimen/_10sdp"
            android:textColor="@color/black_text_color"
            android:textColorHint="@color/colorHint"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone"
            app:fontFamily="@font/pop_regular" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_search"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_25sdp"
        android:padding="@dimen/_2sdp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/_10sdp"
        android:tint="@color/black_text_color"
        app:srcCompat="@drawable/ic_search" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_more_menu"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_25sdp"
        android:padding="@dimen/_2sdp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/_5sdp"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        android:tint="@color/black_text_color"
        app:srcCompat="@drawable/ic_more_white" />


</LinearLayout>