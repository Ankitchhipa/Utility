<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/ad_view_banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?android:attr/selectableItemBackground"
        android:outlineAmbientShadowColor="@color/blue_shadow"
        android:outlineSpotShadowColor="@color/blue_shadow"
        android:visibility="gone"
        card_view:cardBackgroundColor="@android:color/white"
        card_view:cardCornerRadius="@dimen/_10sdp"
        card_view:cardElevation="@dimen/_3sdp"
        card_view:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/nativeSmallAdDocAdapter"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_document"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?android:attr/selectableItemBackground"
        android:outlineAmbientShadowColor="@color/blue_shadow"
        android:outlineSpotShadowColor="@color/blue_shadow"
        card_view:cardBackgroundColor="@android:color/white"
        card_view:cardCornerRadius="@dimen/_10sdp"
        card_view:cardElevation="@dimen/_3sdp"
        card_view:cardUseCompatPadding="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    card_view:cardBackgroundColor="@android:color/white"
                    card_view:cardCornerRadius="8dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_file"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        app:srcCompat="@drawable/ic_loading" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_file_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_medium"
                            android:includeFontPadding="false"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12sdp"
                            app:fontFamily="@font/roboto_medium"
                            tools:text="Pan Card" />

                        <TextView
                            android:id="@+id/tv_file_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:background="@drawable/bg_file_count"
                            android:paddingLeft="4dp"
                            android:paddingTop="1dp"
                            android:paddingRight="4dp"
                            android:paddingBottom="1dp"
                            android:textColor="@color/sky_blue"
                            android:textSize="10sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:includeFontPadding="false"
                        android:textColor="@color/grey_color"
                        android:textSize="@dimen/_10ssp"
                        app:fontFamily="@font/roboto_regular"
                        tools:text="2/14/20 16:18" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_pdf"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:paddingTop="8dp"
                            android:paddingEnd="8dp"
                            android:paddingRight="8dp"
                            android:paddingBottom="8dp"
                            android:visibility="gone"
                            app:srcCompat="@drawable/ic_picture_as_pdf" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_share"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:background="?attr/selectableItemBackground"
                            android:padding="@dimen/_2sdp"
                            android:visibility="gone"
                            app:srcCompat="@drawable/ic_share_gray" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_rename"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:background="?attr/selectableItemBackground"
                            android:padding="@dimen/_2sdp"
                            app:srcCompat="@drawable/ic_rename" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_delete"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:background="?attr/selectableItemBackground"
                            android:padding="@dimen/_2sdp"
                            app:srcCompat="@drawable/ic_delete_new" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_drive"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:background="?attr/selectableItemBackground"
                            android:padding="@dimen/_1sdp"
                            app:srcCompat="@drawable/ic_add_to_drive" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end">

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/checkBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:checked="false"
                    android:visibility="gone"
                    app:buttonTint="@color/sky_blue" />

                <Button
                    android:id="@+id/btnCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent" />
            </FrameLayout>


        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <include
        android:id="@+id/ll_ad_view"
        layout="@layout/activity_ad_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone" />

   <!-- <include
        android:id="@+id/ll_native_ad_view"
        layout="@layout/ll_native_ad_item_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />-->
</LinearLayout>