<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/topLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <com.cam.scanner.scantopdf.android.barcodereader.camera.CameraSourcePreview
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.cam.scanner.scantopdf.android.barcodereader.camera.GraphicOverlay
            android:id="@+id/graphicOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.cam.scanner.scantopdf.android.barcodereader.camera.CameraSourcePreview>

    <com.cam.scanner.scantopdf.android.barcodereader.ScannerOverlay
        android:id="@+id/scan_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000"
        app:line_color="@color/colorPrimary"
        app:line_speed="6"
        app:line_width="5"
        app:square_height="500"
        app:square_width="350" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_media"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:visibility="visible"
        app:srcCompat="@drawable/ic_media" />

    <include
        android:id="@+id/progress_lay"
        layout="@layout/progress_lay"
        android:visibility="gone" />

</RelativeLayout>