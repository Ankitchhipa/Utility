<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_color"
        android:orientation="vertical">

        <include layout="@layout/common_toolbar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="0.7"
                card_view:cardBackgroundColor="@android:color/white"
                card_view:cardCornerRadius="10dp"
                card_view:cardElevation="5dp"
                card_view:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true"
                        android:scrollbars="vertical">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/tv_ocr_result"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:gravity="start|top"
                            android:lineSpacingExtra="2dp"
                            app:fontFamily="@font/roboto_regular"
                            android:padding="15dp"
                            android:textColor="@android:color/black"
                            android:textCursorDrawable="@null"
                            android:textSize="14sp" />
                    </ScrollView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!--<Button
                            android:id="@+id/btn_save_as_pdf"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="15dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_bg"
                            android:text="@string/save_as_pdf"
                            android:textAllCaps="false"
                            android:textColor="@color/sky_blue"
                            android:textSize="14sp"
                            android:visibility="gone" />
-->
                        <Button
                            android:id="@+id/btn_save_as_text"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_margin="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_bg"
                            android:text="@string/save_as_text"
                            app:fontFamily="@font/roboto_medium"
                            android:textAllCaps="false"
                            android:textColor="@color/sky_blue"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btn_view_image"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginHorizontal="10dp"
                            android:layout_marginBottom="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_bg"
                            android:text="@string/view_image"
                            android:textAllCaps="false"
                            app:fontFamily="@font/roboto_medium"
                            android:textColor="@color/sky_blue"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/ad_view_banner_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                card_view:cardBackgroundColor="@android:color/white"
                card_view:cardCornerRadius="10dp"
                card_view:cardElevation="5dp"
                card_view:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_alignParentBottom="true"
                    android:layout_height="@dimen/_110sdp">

                    <FrameLayout
                        android:id="@+id/nativeLargeAdOcrResult"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                </LinearLayout>
                <!--<FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_ocr"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        app:srcCompat="@drawable/ic_loading" />

                   &lt;!&ndash; <include layout="@layout/transparent_lay" />&ndash;&gt;

                    <Button
                        android:id="@+id/btn_view_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|end"
                        android:layout_margin="15dp"
                        android:background="@drawable/pop_up_bg"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/view_image"
                        android:textAllCaps="false"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />
                </FrameLayout>-->
            </androidx.cardview.widget.CardView>

            <include layout="@layout/ocr_bottom_bar" />

        </LinearLayout>

    </LinearLayout>


    <include
        android:id="@+id/progress_lay"
        layout="@layout/progress_lay"
        android:visibility="gone" />
</FrameLayout>