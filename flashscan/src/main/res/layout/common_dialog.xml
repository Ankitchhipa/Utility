<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/pop_up_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="20dp">

        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_round_rect_blue" />

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:includeFontPadding="false"
            android:text="@string/creating_pdf"
            android:textColor="@color/black_text_color"
            android:textSize="18sp"
            app:fontFamily="@font/roboto_bold" />

        <TextView
            android:id="@+id/msg_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:visibility="visible"
            android:text="@string/enter_file_name"
            android:textColor="#748196"
            android:textSize="13sp"
            app:fontFamily="@font/roboto_regular" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_pdf_name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/edit_text_bg"
            android:cursorVisible="true"
            android:gravity="center_vertical"
            android:hint="Enter File name"
            android:importantForAutofill="yes"
            android:includeFontPadding="false"
            android:inputType="text"
            android:maxLength="50"
            android:maxLines="1"    
            android:paddingHorizontal="14dp"
            android:textColor="@color/black_text_color"
            android:textColorHint="#8D99A8"
            android:textCursorDrawable="@null"
            android:textSize="14sp"
            app:fontFamily="@font/roboto_regular"
            tools:hint="Enter File name"
            tools:text="" />

        <RadioGroup
            android:id="@+id/rdo_grp_delete_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#F7FBFF"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/rd_delete_app_only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/black"
                android:checked="true"
                android:paddingVertical="4dp"
                android:text="@string/delete_from_app_only"
                android:textColor="@color/black_text_color"
                android:textSize="13sp"
                app:fontFamily="@font/roboto_regular" />

            <RadioButton
                android:id="@+id/rd_delete_from_both"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/black"
                android:layout_marginTop="6dp"
                android:paddingVertical="4dp"
                android:text="@string/delete_from_both_app_and_google_drive"
                android:textColor="@color/black_text_color"
                android:textSize="13sp"
                app:fontFamily="@font/roboto_regular" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="#E7EDF4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:gravity="center"
                android:text="@string/no"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:fontFamily="@font/roboto_medium" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btn_ok"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:gravity="center"
                android:text="@string/yes"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:fontFamily="@font/roboto_medium" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
