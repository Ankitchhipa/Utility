<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@drawable/blue_shadow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_save_as_pdf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:drawableTint="@color/black_text_color"
            android:drawableTop="@drawable/ic_pdf_black_without_filed_new"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="@color/black_text_color"
            android:text="@string/save_as_pdf"
            android:textSize="12sp"
            app:fontFamily="@font/roboto_medium" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:drawableTint="@color/black_text_color"
            android:drawableTop="@drawable/ic_share_without_filled_new"
            android:gravity="center"
            android:textColor="@color/black_text_color"
            android:padding="8dp"
            android:text="@string/share"
            android:textSize="12sp"
            app:fontFamily="@font/roboto_medium" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:drawableTint="@color/black_text_color"
            android:drawableTop="@drawable/ic_delete_without_filled_new"
            android:gravity="center"
            android:textColor="@color/black_text_color"
            android:padding="8dp"
            android:text="@string/delete"
            android:textSize="12sp"
            app:fontFamily="@font/roboto_medium" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_copy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:drawableTint="@color/black_text_color"
            android:drawableTop="@drawable/ic_copy"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/copy"
            android:textSize="12sp"
            android:visibility="gone"
            app:fontFamily="@font/roboto_medium" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_move"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:drawableTint="@color/black_text_color"
            android:drawableTop="@drawable/ic_move"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/move"
            android:textSize="12sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_star"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:drawableTint="@color/black_text_color"
            android:drawableTop="@drawable/ic_unstarred"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/not_starred"
            android:textSize="12sp"
            android:visibility="gone"
            app:fontFamily="@font/roboto_medium" />
    </LinearLayout>
</LinearLayout>