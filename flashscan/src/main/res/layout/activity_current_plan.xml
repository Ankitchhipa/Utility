<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity"
        android:background="@color/colorPrimary">

        <View
            android:id="@+id/view1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_200sdp"
            android:background="@android:color/white"
            android:orientation="vertical">

        </View>

        <RelativeLayout
            android:id="@+id/rl_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/closeIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:padding="@dimen/_5sdp"
                app:srcCompat="@drawable/ic_close" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:padding="@dimen/_2sdp"
                android:text="@string/change_plan"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_13ssp" />
        </RelativeLayout>

       <!-- <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/bottomLayout"
            android:layout_below="@+id/rl_top">-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_above="@+id/bottomLayout"
                android:layout_below="@+id/rl_top"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="@dimen/_2sdp"
                    android:text="@string/current_subscription"
                    android:textColor="@color/premium_bar"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:id="@+id/tv_current_plan_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="@dimen/_2sdp"
                    android:textColor="@color/orange_premium_access"
                    android:textSize="24dp" />

                <ProgressBar
                    android:id="@+id/progress_bar_active_plan"
                    style="@android:style/Widget.ProgressBar.Small"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:elevation="@dimen/_2sdp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/colorPrimary"
                    android:indeterminateTintMode="src_in"
                    android:visibility="gone" />


                <TextView
                    android:id="@+id/tv_current_plan_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="#F1F9FE"
                    android:gravity="center"
                    android:padding="@dimen/_2sdp"
                    android:textColor="@color/premium_bar"
                    android:textSize="@dimen/_14sdp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">



                    <LinearLayout
                        android:id="@+id/linear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/colorPrimary">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/premium_features_details"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_13sdp"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:visibility="gone"/>



                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/upgradePlanFeatureRecycler"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:layout_marginEnd="@dimen/_15sdp"
                            android:layout_marginTop="@dimen/_15sdp"
                            android:layout_marginBottom="@dimen/_5sdp"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                            tools:itemCount="4"
                            app:spanCount="2"
                            tools:listitem="@layout/item_upgrade_plan_feature"
                            android:visibility="gone"/>



                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/dotsLinearLayout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_gravity="center"
                                android:visibility="visible">

                            <ImageView
                                android:id="@+id/img_indicator1"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/circle_filled_white"
                                android:visibility="visible"
                                />
                            <ImageView
                                android:id="@+id/img_indicator2"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginLeft="@dimen/_5sdp"
                                android:background="@drawable/circle_empty_white"
                                android:visibility="visible"/>

                            </LinearLayout>
                        </FrameLayout>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_upgradePlan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:layout_marginEnd="@dimen/_15sdp"
                            android:layout_marginTop="@dimen/_20sdp"
                            android:clipToPadding="false"
                            app:cardCornerRadius="@dimen/_5sdp"
                            android:layout_marginBottom="@dimen/_5sdp"
                            android:visibility="visible">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/_10sdp"
                                android:paddingTop="@dimen/_5sdp"
                                android:paddingEnd="@dimen/_20sdp"
                                android:paddingBottom="5dp">

                                <TextView
                                    android:id="@+id/tv_upgrade_plan_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_16ssp" />

                                <TextView
                                    android:id="@+id/tv_upgrade_plan_price"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_12ssp" />

                                <ProgressBar
                                    android:id="@+id/progress_bar_upgrade_plan"
                                    style="@android:style/Widget.ProgressBar.Small"
                                    android:layout_width="@dimen/_20sdp"
                                    android:layout_height="@dimen/_20sdp"
                                    android:layout_marginStart="@dimen/_5sdp"
                                    android:layout_gravity="center"
                                    android:elevation="@dimen/_2sdp"
                                    android:indeterminate="true"
                                    android:indeterminateTint="@color/colorPrimary"
                                    android:indeterminateTintMode="src_in"
                                    android:visibility="gone" />

                            </LinearLayout>


                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_right_arrow"
                                android:layout_gravity="right"
                                android:layout_marginEnd="10dp"/>

                            <ProgressBar
                                android:id="@+id/progress_bar"
                                style="@android:style/Widget.ProgressBar.Small"
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:layout_gravity="center"
                                android:elevation="@dimen/_2sdp"
                                android:indeterminate="true"
                                android:indeterminateTint="@color/colorPrimary"
                                android:indeterminateTintMode="src_in"
                                android:visibility="gone" />



                        </androidx.cardview.widget.CardView>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/auto_renews_yearly_cancel_anytime"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_11ssp" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_manage_subscription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:layout_marginEnd="@dimen/_15sdp"
                            android:layout_marginTop="@dimen/_15sdp"
                            android:clipToPadding="false"
                            app:cardCornerRadius="@dimen/_5sdp"
                            android:layout_marginBottom="@dimen/_5sdp"
                            android:visibility="visible">

                            <LinearLayout
                                android:id="@+id/tv_manage_subscription"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/_10sdp"
                                android:paddingTop="@dimen/_5sdp"
                                android:paddingEnd="@dimen/_20sdp"
                                android:paddingBottom="5dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_16ssp"
                                    android:text="@string/manage_subscription_at_playstore"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="@string/at_google_playstore"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_12ssp" />

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/tv_manage_info"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_info_orange"
                                android:layout_gravity="right"
                                android:layout_marginEnd="10dp"/>

                        </androidx.cardview.widget.CardView>

                      <!--  <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:layout_marginEnd="@dimen/_15sdp"
                            android:clipToPadding="false"
                            app:cardCornerRadius="@dimen/_5sdp">-->
                          <LinearLayout
                              android:layout_width="match_parent"
                              android:layout_height="wrap_content"
                              android:orientation="vertical"
                              android:padding="@dimen/_15sdp">


                              <TextView
                                  android:id="@+id/tv_disclaimer"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:text="@string/disclaimer"
                                  android:layout_gravity="center"
                                  android:textColor="@color/white"
                                  android:textSize="@dimen/_12ssp"/>

                              <TextView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:layout_gravity="center"
                                  android:gravity="center"
                                  android:text="@string/disclaimer_content"
                                  android:textColor="@color/white"
                                  android:textSize="@dimen/_12ssp"
                                  android:layout_marginTop="@dimen/_10sdp"
                                  android:layout_marginBottom="@dimen/_10sdp"
                                  android:lineSpacingExtra="@dimen/_5sdp"/>

                          </LinearLayout>
                      <!--  </androidx.cardview.widget.CardView>-->
                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>


      <!--  </androidx.core.widget.NestedScrollView>-->

        <LinearLayout
            android:id="@+id/bottomLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/colorPrimary"
            android:orientation="vertical"
            android:paddingTop="@dimen/_10sdp">



