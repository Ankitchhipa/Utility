<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="120dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_blue"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1FFFFFFF"
                        android:includeFontPadding="false"
                        android:paddingStart="10dp"
                        android:visibility="gone"
                        android:layout_marginHorizontal="20dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:text="@string/module_name"
                        android:textAllCaps="true"
                        android:textColor="@color/black_text_color"
                        android:textSize="11sp"
                        app:fontFamily="@font/roboto_medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:includeFontPadding="false"
                        android:layout_marginHorizontal="20dp"
                        android:text="@string/pdf_scanner_doc_scanner"
                        android:textColor="@color/black_text_color"
                        android:textSize="26sp"
                        app:fontFamily="@font/roboto_bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:alpha="0.88"
                        android:layout_marginHorizontal="20dp"
                        android:text="Scan, extract, and organize your documents in one place."
                        android:textColor="@color/black_text_color"
                        android:textSize="13sp"
                        app:fontFamily="@font/roboto_regular" />

                    <LinearLayout
                        android:id="@+id/ll_doc_scanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:layout_marginHorizontal="20dp"
                        android:background="@drawable/bg_round_rect_white"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="88dp"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_yellow_circle"
                            android:foregroundGravity="center"
                            android:padding="14dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:srcCompat="@drawable/ic_doc_new" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/document_scanner"
                                android:textColor="@color/blue_text_color"
                                android:textSize="17sp"
                                app:fontFamily="@font/roboto_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Create crystal-clear scans with one tap."
                                android:textColor="#6A7A90"
                                android:textSize="12sp"
                                app:fontFamily="@font/roboto_regular" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:tint="@color/blue_text_color"
                            app:srcCompat="@drawable/ic_arrow_forward" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:visibility="gone"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/fl_ocr"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginVertical="20dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_round_rect_white"
                            android:elevation="3dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="136dp"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <FrameLayout
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_blue_gradient_circle"
                                    android:padding="12dp">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        app:srcCompat="@drawable/ic_ocr_to_text" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:includeFontPadding="false"
                                    android:text="@string/ocr"
                                    android:textColor="@color/blue_text_color"
                                    android:textSize="16sp"
                                    app:fontFamily="@font/roboto_bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="@string/images_to_text"
                                    android:textColor="#6A7A90"
                                    android:textSize="11sp"
                                    app:fontFamily="@font/roboto_regular" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end|top"
                                android:background="#F3F7FD"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingStart="8dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="6dp"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/coming"
                                    android:textColor="@color/blue_text_color"
                                    android:textSize="8sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/soon"
                                    android:textColor="@color/blue_text_color"
                                    android:textSize="8sp" />
                            </LinearLayout>
                        </FrameLayout>


                        <FrameLayout
                            android:id="@+id/fl_bar_code"
                            android:layout_width="0dp"
                            android:layout_marginVertical="20dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10sp"
                            android:layout_marginEnd="20dp"
                            android:background="@drawable/bg_round_rect_white"
                            android:elevation="3dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="136dp"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <FrameLayout
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_blue_circle_gradient"
                                    android:padding="12dp">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        app:srcCompat="@drawable/ic_qr_bar_code_new" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:includeFontPadding="false"
                                    android:text="@string/qr_bar_code"
                                    android:textColor="@color/blue_text_color"
                                    android:textSize="16sp"
                                    app:fontFamily="@font/roboto_bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:includeFontPadding="false"
                                    android:text="(Scan &amp; Create)"
                                    android:textColor="#6A7A90"
                                    android:textSize="11sp"
                                    app:fontFamily="@font/roboto_regular" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end|top"
                                android:background="#F3F7FD"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingStart="8dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="6dp"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/coming"
                                    android:textColor="@color/blue_text_color"
                                    android:textSize="8sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/soon"
                                    android:textColor="@color/blue_text_color"
                                    android:textSize="8sp" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_favorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_heading_favorites"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/my_favourites"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:textColor="@color/black_text_color"
                        android:textSize="16sp"
                        android:visibility="visible"
                        app:fontFamily="@font/roboto_bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_favorites"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/ll_no_favorite_document"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="20dp"
                        android:background="@drawable/bg_curve_white"
                        android:elevation="5dp"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="#F1F7FE"
                            android:padding="8dp"
                            app:srcCompat="@drawable/ic_no_favorite" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_medium"
                                android:text="@string/no_favorite_document"
                                android:textColor="@color/black_text_color"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/click_star_doc"
                                android:textColor="#7C8798"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="8dp">

                        <TextView
                            android:id="@+id/tv_heading_recent_docs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:layout_centerVertical="true"
                            android:text="@string/recent_documents"
                            android:textColor="@color/black_text_color"
                            android:textSize="16sp"
                            android:visibility="visible"
                            app:fontFamily="@font/roboto_bold" />

                        <LinearLayout
                            android:id="@+id/viewAllDoc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:visibility="gone"
                            android:gravity="center">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:minHeight="32dp"
                                android:paddingStart="12dp"
                                android:paddingTop="6dp" android:paddingBottom="6dp"
                                android:text="@string/view_all"
                                android:textColor="@color/black_text_color"
                                android:textSize="12sp"
                                app:fontFamily="@font/roboto_medium" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:src="@drawable/ic_arrow_new"
                                android:rotation="180"/>

                        </LinearLayout>

                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:descendantFocusability="blocksDescendants"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_scanner_files"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            card_view:itemCount="2"
                            card_view:listitem="@layout/item_view_files_list" />

                        <include
                            android:id="@+id/ll_no_document"
                            layout="@layout/ll_no_document_scan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/ad_view_banner_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:visibility="gone"
                            app:cardBackgroundColor="#F8FBFF"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:gravity="center"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:id="@+id/nativeSmallAdNoDoc"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="28dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="10dp"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:id="@+id/ll_floating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_camera"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_blue_circle_gradient"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_camera_blue" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="#140D2740" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_media"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_round_rect_white"
                    android:padding="12dp"
                    android:tint="@color/black_text_color"
                    app:srcCompat="@drawable/ic_gallery_sky_blue" />
            </LinearLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_camera"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_camera" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_media"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:scaleX="0.8"
                android:scaleY="0.8"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_media" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <include
        android:id="@+id/ll_bottom_bar"
        layout="@layout/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <include
        android:id="@+id/progress_lay"
        layout="@layout/progress_lay"
        android:visibility="gone" />
</FrameLayout>
