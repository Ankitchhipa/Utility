<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/toolbar_color</item>
        <item name="android:itemTextAppearance">@style/TextAppearance</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="MyCheckbox" parent="@style/Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:colorControlNormal" tools:targetApi="lollipop">#ffd600</item>
        <item name="android:colorControlActivated" tools:targetApi="lollipop">#0091ea</item>
        <item name="android:colorControlHighlight" tools:targetApi="lollipop">#c51162</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat</item>
    </style>

    <style name="dialog_title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/dialog_txt_color</item>

    </style>

    <style name="buttonStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@android:color/black</item>

    </style>

    <style name="AppTheme.FullScreen">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme.NoTitle.FullScreen" parent="AppTheme">
        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="AppTheme.Splash" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>

    <style name="AppTheme.Activity">
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="TextAppearance">
        <item name="actionMenuTextColor">@color/sky_blue</item>
        <item name="android:actionMenuTextColor">@color/sky_blue</item>
    </style>

    <style name="AppTheme.AdAttribution">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:text">@string/ad</item>
        <item name="android:background">@color/colorPrimaryDark</item>
        <item name="android:width">18dp</item>
        <item name="android:height">18dp</item>
    </style>

    <style name="CameraShotCounter" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">#1F92E1</item>
        <item name="android:background">@drawable/shot_counter_background</item>
    </style>

    <style name="CameraConsole" parent="CameraShotCounter">
        <item name="android:textColor">@color/camera_message_text_color</item>
        <item name="android:background">@drawable/camera_console_item_background</item>
    </style>

    <style name="CameraTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Full screen Camera -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>

        <item name="camera_flash_off">@drawable/ic_action_flash_off_dark</item>
        <item name="camera_flash_on">@drawable/ic_action_flash_on_dark</item>
        <item name="camera_corners_off">@drawable/ic_camera_detector_off</item>
        <item name="camera_corners_on">@drawable/ic_camera_detector_on</item>
        <item name="camera_mode_single">@drawable/ic_camera_singlemode</item>
        <item name="camera_mode_batch">@drawable/ic_camera_batchmode</item>
        <item name="camera_shake_overlay">@drawable/ic_camera_shake_on_wave</item>
    </style>

    <color name="dialog_txt_color">#303030</color>

    <style name="Transparent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
