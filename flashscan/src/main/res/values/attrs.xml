<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="ScannerOverlay">
        <attr name="square_width" format="integer" />
        <attr name="square_height" format="integer" />
        <attr name="line_color" format="color" />
        <attr name="line_width" format="integer" />
        <attr name="line_speed" format="integer" />
    </declare-styleable>

    <declare-styleable name="BarcodeReaderFragment">
        <attr name="auto_focus" format="boolean" />
        <attr name="use_flash" format="boolean" />
    </declare-styleable>

    <declare-styleable name="SingleFingerView">
        <attr name="image" format="reference" />
        <attr name="image_width" format="dimension" />
        <attr name="image_height" format="dimension" />
        <attr name="push_image" format="reference" />
        <attr name="delete_image" format="reference" />
        <attr name="push_image_width" format="dimension" />
        <attr name="push_image_height" format="dimension" />
        <attr name="delete_image_width" format="dimension" />
        <attr name="delete_image_height" format="dimension" />
        <attr name="top" format="dimension" />
        <attr name="left" format="dimension" />
        <attr name="right" format="dimension" />
        <attr name="centerInParent" format="boolean" />
    </declare-styleable>
</resources>