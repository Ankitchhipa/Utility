            <include android:id="@+id/toolbar"
                layout="@layout/main_toolbar_apc" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">

                <RelativeLayout
                    android:id="@+id/arclayout"
                    android:layout_width="wrap_content"
