                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical">

                <include layout="@layout/btm_ads_scanning" />
            </LinearLayout>

            <include
                layout="@layout/junk_bottom_sheet"
                android:visibility="gone" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/layout_two"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:background="@color/sidebar_header_color"
            android:visibility="gone">

            <include layout="@layout/backpress_ads_screen" />
        </RelativeLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_ad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/ad_view_banner_container"
        android:background="@color/grayseperator"
        android:paddingLeft="@dimen/margin_8"
        android:textColor="@color/white"
        android:textSize="@dimen/font_10" />

    <LinearLayout
        android:id="@+id/ad_view_banner_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_110sdp"
        android:layout_above="@id/margin_btm"
        android:layout_alignParentBottom="true"
        android:layout_margin="@dimen/_4sdp"
        android:background="@drawable/ad_background"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/nativeLargeSocialAnim"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

    <View
        android:id="@+id/margin_btm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true" />
