    android:animateLayoutChanges="true"
    android:background="@android:color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/tv_ad"
        android:background="@android:color/white"
        android:orientation="vertical">

        <RelativeLayout
