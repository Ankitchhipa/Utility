<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    tools:context=".similerphotos.DuplicatesActivity">

    <RelativeLayout
        android:id="@+id/layout_one"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include android:id="@+id/toolbar"
            layout="@layout/main_toolbar_apc" />

        <TextView
            android:id="@+id/tvnoduplicates"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/str_strnodup"
            android:textColor="@color/txt_color"
            android:typeface="monospace"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/toplayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbar"
            android:background="@color/sidebar_header_color"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="@dimen/margin_8">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dupdisplay_sizetv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    app:fontFamily="@font/roboto_medium"
                    android:textColor="@color/colorPrimaryDark" />

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4"
                    android:layout_marginBottom="@dimen/margin_4">

                    <TextView
                        android:id="@+id/junkdisplay_sizetv_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_2"
                        android:layout_marginLeft="@dimen/margin_2"
                        android:text="MB"
                        android:textColor="@color/txt_color"
                        app:fontFamily="@font/roboto_medium"
                        android:textSize="@dimen/font_14" />

                    <TextView
                        android:id="@+id/symbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/junkdisplay_sizetv_unit"
                        android:text=""
                        app:fontFamily="@font/roboto_medium"
                        android:textColor="@color/txt_color" />
                </RelativeLayout>


            </LinearLayout>


            <TextView
                android:id="@+id/junkdisplay_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_space_optimized"
                android:textColor="@color/txt_color"
                app:fontFamily="@font/roboto_regular"
                android:textSize="@dimen/_14ssp"
                android:includeFontPadding="false"/>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/ad_view_banner_container"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_below="@+id/toplayout"
            android:gravity="center"
            android:background="@drawable/ad_background"
            android:layout_margin="@dimen/margin_8"
            android:layout_height="@dimen/_55sdp">

            <FrameLayout
                android:id="@+id/nativeSmallAdDuplicateMid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/ll"
            android:layout_below="@+id/ad_view_banner_container"
            android:orientation="vertical">

            <TextView
                android:id="@+id/imagecount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:textColor="@color/txt_color"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="vertical" />

            <ListView
                android:id="@+id/listview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:animationCache="false"
                android:background="@android:color/white"
                android:divider="@null"
                android:scrollingCache="false"
                android:smoothScrollbar="true"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/dup_btn_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                style="@style/BottomButtonStyle"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dup_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/str_str_empty_compress"
                    android:textColor="@android:color/white"
                    app:fontFamily="@font/roboto_medium"
                    android:textSize="@dimen/font_18" />

                <!--<TextView-->
                <!--android:id="@+id/dup_text"-->
                <!--android:layout_width="match_parent"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:layout_gravity="bottom"-->
                <!--android:gravity="center|bottom"-->
                <!--android:text="@string/str_str_empty_compress"-->
                <!--android:textColor="@android:color/white"-->
                <!--android:textSize="@dimen/font_12" />-->

                <!--<TextView-->
                <!--android:layout_width="match_parent"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:layout_gravity="top"-->
                <!--android:gravity="top|center"-->
                <!--android:text="@string/str_str_rem_dup"-->
                <!--android:textColor="@android:color/white"-->
                <!--android:textSize="@dimen/font_18" />-->

            </LinearLayout>

            <TextView
                android:id="@+id/tv_ad"
                android:layout_width="match_parent"
                android:paddingLeft="@dimen/margin_8"
                android:layout_height="0dp"
                android:background="@color/grayseperator"
                android:textSize="@dimen/font_10"
                android:layout_above="@id/ad_view_banner_container"
                android:textColor="@color/white" />



            <View
                android:id="@+id/margin_btm"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_alignParentBottom="true" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layout_two"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="@color/black"
        android:visibility="gone">

        <include layout="@layout/backpress_ads_screen" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layout_three"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="@color/sidebar_header_color"
        android:visibility="gone">

        <include layout="@layout/backpress_ads_screen_deletion" />
    </RelativeLayout>


</RelativeLayout>
