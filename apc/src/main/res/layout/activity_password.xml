<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_password"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorAccent">

    <LinearLayout
        android:id="@+id/top_lays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/forgetPassword"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/img_lock"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/splesh_logo" />

        <TextView
            android:id="@+id/textView_lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_8"
            android:layout_marginRight="@dimen/margin_8"
            android:layout_marginTop="@dimen/margin_2"
            android:fontFamily="@string/font_family_thin"
            android:gravity="center"
            android:text="@string/draw_pattern"
            android:textColor="@color/white"
            android:textSize="@dimen/font_22" />

       <!-- <com.takwolf.android.lock9.Lock9View
            android:id="@+id/lock_9_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:lineWidth="4dp"
            app:lineColor="@color/line_color_lock"
            app:nodeOnSrc="@drawable/lock_9_view_node_highlighted"
            app:nodeSrc="@drawable/lock_9_view_node_normal" />-->

        <ImageView
            android:id="@+id/finger_print_scan"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_40"
            android:layout_margin="@dimen/margin_4"
            android:src="@drawable/ic_finger_print_icon"
            android:tint="@color/white"
            />

      <!--  <com.takwolf.android.lock9.Lock9View
            android:id="@+id/lock_invisible_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:lineColor="@android:color/transparent"
            app:lineWidth="4dp"
            app:nodeOnSrc="@drawable/lock_9_view_node_normal"
            app:nodeSrc="@drawable/lock_9_view_node_normal" />-->
    </LinearLayout>

    <Button
        android:id="@+id/forgetPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/margin_8"
        android:layout_marginLeft="@dimen/margin_16"
        android:layout_marginRight="@dimen/margin_16"
        android:background="@drawable/btn_bg"
        android:fontFamily="@string/font_family_thin"
        android:text="@string/forget_password"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="@dimen/font_16" />

</RelativeLayout>
