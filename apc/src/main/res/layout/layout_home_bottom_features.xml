    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/bottom_card_large_files"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/margin_14"
            android:paddingBottom="@dimen/margin_10">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight=".8"
                android:background="@android:color/white"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/large_file" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight=".3"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingStart="@dimen/margin_5"
                android:paddingLeft="@dimen/margin_5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/margin_8"
                    android:paddingLeft="@dimen/margin_8"
                    android:text="@string/str_large_files"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_16"
                    app:fontFamily="@font/roboto_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_5"
                    android:lineSpacingExtra="1dp"
                    android:paddingLeft="@dimen/margin_8"
                    android:paddingRight="@dimen/margin_8"
                    android:text="@string/str_txt_antivirus"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/font_14"
                    app:fontFamily="@font/roboto_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/margin_8"
                    android:layout_marginEnd="@dimen/margin_14"
                    android:layout_marginBottom="@dimen/margin_6"
                    android:text="@string/str_protect_now"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="@dimen/font_13"
                    app:fontFamily="@font/roboto_bold" />

            </LinearLayout>

        </LinearLayout>

