<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default">

    <TextView
        android:id="@+id/tv_gird"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/realtive_top_layer"
        android:gravity="center"
        android:text="@string/str_notfound"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/txt_color"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tv_bottom_msg"
        android:layout_below="@+id/linear_mid_layer"
        android:background="@color/white"
        android:horizontalSpacing="@dimen/margin_1"
        android:numColumns="4"
        android:verticalSpacing="@dimen/margin_1"
        android:visibility="gone" />

    <com.advanced.phone.junk.cache.cleaner.booster.antimalware.utility.SocialGridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tv_bottom_msg"
        android:layout_below="@+id/linear_mid_layer"
        android:layout_marginBottom="@dimen/margin_30"
        android:adjustViewBounds="true"
        android:background="@color/white"
        android:drawSelectorOnTop="true"
        android:focusable="false"
        android:gravity="center"
        android:horizontalSpacing="@dimen/margin_1"
        android:numColumns="4"
        android:scrollbarStyle="outsideOverlay"
        android:verticalSpacing="@dimen/margin_1" />

    <Button
        android:id="@+id/btnfiledelete"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="@dimen/margin_16"
        android:layout_marginTop="@dimen/margin_8"
        android:layout_marginRight="@dimen/margin_16"
        android:layout_marginBottom="@dimen/margin_8"
        android:background="@drawable/rounded_drawable"

        android:padding="@dimen/margin_4"
        android:stateListAnimator="@null"
        android:text="@string/str_delete"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="@dimen/font_18"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_bottom_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/bg_default"

        android:gravity="center"
        android:paddingLeft="@dimen/margin_16"
        android:paddingTop="@dimen/margin_10"
        android:paddingRight="@dimen/margin_16"
        android:paddingBottom="@dimen/margin_8"
        android:textSize="@dimen/font_14" />

    <LinearLayout
        android:id="@+id/linear_mid_layer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/realtive_top_layer"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:background="@color/white"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/margin_16"
            android:paddingLeft="@dimen/margin_16"
            android:paddingTop="@dimen/margin_8"
            android:paddingEnd="@dimen/margin_12"
            android:paddingRight="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_8">

            <TextView
                android:id="@+id/tv_social_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"

                android:textSize="@dimen/font_16" />

            <TextView
                android:id="@+id/tv_social_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginEnd="@dimen/margin_8"
                android:layout_marginRight="@dimen/margin_8"
                android:layout_toStartOf="@+id/checkAll"
                android:layout_toLeftOf="@+id/checkAll"

                android:textSize="@dimen/font_16" />

            <CheckBox
                android:id="@+id/checkAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:button="@drawable/custom_checkbox"
                android:checked="false" />


        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_1"
            android:layout_marginLeft="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_4"
            android:layout_marginRight="@dimen/margin_16"
            android:background="@color/bg_default" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/realtive_top_layer"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:background="@color/redappcolor">

        <LinearLayout
            android:id="@+id/linear_tool"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/margin_16"
                android:src="@drawable/ic_back_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/str_turbo_cleaner"
                android:textColor="@color/white"
                android:textSize="@dimen/font_18" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_above="@+id/tv_recover"
            android:layout_below="@+id/linear_tool"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="visible">

            <TextView
                android:id="@+id/mediadisplay_sizetv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="0"
                android:textColor="@color/white" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4">

                <TextView
                    android:id="@+id/mediadisplay_sizetv_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginLeft="@dimen/margin_2"

                    android:text="MB"
                    android:textColor="@color/white"
                    android:textSize="@dimen/font_14" />

                <TextView
                    android:id="@+id/symbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text=""
                    android:textColor="@color/white" />
            </RelativeLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_recover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/margin_6"

            android:text="@string/str_space_optimized"
            android:textColor="@color/white"
            android:textSize="@dimen/font_16" />

    </RelativeLayout>

</RelativeLayout>