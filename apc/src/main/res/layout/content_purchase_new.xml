<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".purchase.PurchaseScreen"
    android:orientation="vertical"
    android:weightSum="2">
    <RelativeLayout
        android:id="@+id/rl_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:background="@drawable/adfree_bg_gradient"
       >

        <ImageView
            android:id="@+id/closebtn"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_alignParentRight="true"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/ic_close_dark" />

        <TextView
            android:id="@+id/tv_purc_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/closebtn"
            android:gravity="center"
            android:text="@string/get_total_ad_free_experience"
            android:textSize="@dimen/font_22"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/tv_purc_head2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_purc_head"
            android:gravity="center"
            android:text="@string/ads_experience"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold"
            android:visibility="gone" />

        <RelativeLayout
            android:id="@+id/img_inapp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_purc_head2"
            android:layout_above="@+id/tv_free_version"
            android:padding="@dimen/_10sdp"
            android:gravity="center">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ad_free_circle_bg" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_free_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/_10sdp"
            android:gravity="center"
            android:paddingLeft="@dimen/margin_16"
            android:paddingRight="@dimen/margin_16"
            android:text="@string/appname"
            android:textColor="@color/white"
            android:textSize="@dimen/font_22"
            android:textStyle="bold" />

    </RelativeLayout>


   <!-- <RelativeLayout
        android:id="@+id/img_inapp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8"
        android:padding="@dimen/_10sdp"
        android:gravity="center">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_150sdp"
            android:layout_marginBottom="@dimen/margin_10"
            android:src="@drawable/splesh_logo" />

    </RelativeLayout>-->

    <RelativeLayout
        android:id="@+id/rl_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight=".7"
        android:background="@color/white">

        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:paddingLeft="@dimen/margin_16"
            android:paddingRight="@dimen/margin_16"
            android:text="@string/appname"
            android:textColor="@color/black"
            android:textSize="@dimen/font_22"
            android:textStyle="bold"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/btn_purchase"
            android:layout_below="@+id/app_name"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/ic_no_ad"
                android:drawablePadding="@dimen/_20sdp"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_18sdp"
                android:paddingVertical="@dimen/margin_15"
                android:text="@string/no_ads"
                android:textColor="@color/black"
                android:textSize="@dimen/font_18" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/ic_cleaning"
                android:drawablePadding="@dimen/_20sdp"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_18sdp"
                android:paddingVertical="@dimen/margin_15"
                android:text="@string/quick_auto_cleaning"
                android:textColor="@color/black"
                android:textSize="@dimen/font_18" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/ic_speed"
                android:drawablePadding="@dimen/_20sdp"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_18sdp"
                android:paddingVertical="@dimen/margin_15"
                android:text="@string/more_storage_better_speed"
                android:textColor="@color/black"
                android:textSize="@dimen/font_18"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/ic_optimizing"
                android:drawablePadding="@dimen/_20sdp"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_18sdp"
                android:paddingVertical="@dimen/margin_15"
                android:text="@string/real_time_optimization"
                android:textColor="@color/black"
                android:textSize="@dimen/font_18"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_purc_btm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btn_purchase"
            android:layout_marginBottom="@dimen/margin_10"
            android:gravity="center"
            android:paddingLeft="@dimen/margin_16"
            android:paddingRight="@dimen/margin_16"
            android:text="@string/ads_experience_tot"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btn_purchase"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_45"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="@dimen/margin_10"
            android:layout_marginTop="@dimen/margin_10"
            android:layout_marginRight="@dimen/margin_10"
            android:layout_marginBottom="@dimen/margin_20"
            android:background="@color/colorPrimaryDark"
            android:text="One-Time Buy $4.99"
            android:textColor="@color/white"
            android:textSize="@dimen/font_18" />
    </RelativeLayout>


</LinearLayout>