<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#eeeeee"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/ll_pattern">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_12"
                android:layout_marginTop="@dimen/margin_10"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_pattern"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif"
                    android:paddingLeft="@dimen/margin_3"
                    android:text="Pattern"
                    android:textColor="@color/tab_btn_txt"
                    android:textSize="@dimen/font_20" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_10"
                android:layout_marginRight="@dimen/margin_10"
                card_view:cardCornerRadius="@dimen/margin_5"
                card_view:cardElevation="@dimen/margin_4"
                card_view:cardUseCompatPadding="true"
                card_view:contentPadding="@dimen/margin_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/lay_change_pattern"
                        android:layout_width="wrap_content"
                        android:layout_height="?actionBarSize"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:drawablePadding="@dimen/margin_16"
                            android:src="@drawable/pattern" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_change_unlock_pattern"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_8"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/change_unlock"
                                android:textColor="@color/tab_btn_txt"
                                android:textSize="@dimen/font_18" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/click_change_unlock"
                                android:textSize="@dimen/font_12" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/margin_8"
                        android:background="@color/seprator" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="?actionBarSize"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:drawablePadding="@dimen/margin_16"
                            android:src="@drawable/visible" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_8"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/make_pattern_visble"
                                android:textColor="@color/tab_btn_txt"
                                android:textSize="@dimen/font_18" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/draw_unlock"
                                android:textSize="@dimen/font_12" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchButton_pattern"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:checked="true"
                            android:gravity="right"
                            android:textAppearance="?android:attr/textAppearanceMedium"

                            />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/ll_pin">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_10"
                android:layout_marginTop="@dimen/margin_10"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_pin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif"
                    android:paddingLeft="@dimen/margin_3"
                    android:text="Pin"
                    android:textColor="@color/tab_btn_txt"
                    android:textSize="@dimen/font_20" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_10"
                android:layout_marginRight="@dimen/margin_10"
                card_view:cardCornerRadius="@dimen/margin_5"
                card_view:cardElevation="@dimen/margin_4"
                card_view:cardUseCompatPadding="true"
                card_view:contentPadding="@dimen/margin_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/lay_chang_pin"
                        android:layout_width="match_parent"
                        android:layout_height="?actionBarSize"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:drawablePadding="@dimen/margin_16"
                            android:src="@drawable/password" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/chang_unlock_setting_new"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_8"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/change_unlock_pin"
                                android:textColor="@color/tab_btn_txt"
                                android:textSize="@dimen/font_18" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/click_change_unlock_pin"
                                android:textSize="@dimen/font_12" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/margin_8"
                        android:background="@color/seprator" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="?actionBarSize"
                        android:orientation="horizontal"
                        android:id="@+id/ll_switch">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:drawablePadding="@dimen/margin_16"
                            android:src="@drawable/visible" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_8"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/make_pin_visble"
                                android:textColor="@color/tab_btn_txt"
                                android:textSize="@dimen/font_18" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/draw_unlock_pin"
                                android:textSize="@dimen/font_12" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchButton_pin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:checked="true"
                            android:gravity="right"
                            android:textAppearance="?android:attr/textAppearanceMedium"

                            />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:id="@+id/card_view1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginTop="@dimen/margin_10"
        android:layout_marginRight="@dimen/margin_10"
        card_view:cardCornerRadius="@dimen/margin_2"
        card_view:cardUseCompatPadding="true"
        card_view:contentPadding="@dimen/margin_5">

        <LinearLayout
            android:id="@+id/fingerPrint_layout"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="@dimen/margin_16"
                android:src="@drawable/ic_finger_print_icon" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_8"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:paddingLeft="@dimen/margin_8"
                    android:text="@string/fingerprint_auth"
                    android:textColor="@color/tab_btn_txt"
                    android:textSize="@dimen/font_18" />

                <TextView
                    android:id="@+id/can_use_fingerprint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:paddingLeft="@dimen/margin_8"
                    android:text="@string/use_fingerprint_unlock"
                    android:textSize="@dimen/font_12" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchButton_finger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:checked="true"
                android:gravity="right"
                android:textAppearance="?android:attr/textAppearanceMedium"

                />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

        <!---->

        <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:id="@+id/card_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_4"
            android:layout_marginRight="@dimen/margin_4"
            android:layout_marginTop="@dimen/margin_4"
            android:visibility="gone"
            card_view:cardCornerRadius="@dimen/margin_2"
            card_view:cardElevation="@dimen/margin_4"
            card_view:cardUseCompatPadding="true"
            card_view:contentPadding="@dimen/margin_5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/margin_16"
                    android:fontFamily="sans-serif"
                    android:padding="@dimen/margin_8"
                    android:text="@string/antivirus"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/font_20"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="@dimen/margin_12"
                    android:layout_marginLeft="@dimen/margin_20"
                    android:layout_marginTop="@dimen/margin_12"
                    android:background="@color/seprator" />

                <TextView
                    android:id="@+id/tv_unlock_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/unlock"
                    android:drawablePadding="@dimen/margin_16"
                    android:drawableRight="@drawable/mid_sidebararrow"
                    android:fontFamily="sans-serif"
                    android:padding="@dimen/margin_8"
                    android:text="@string/unlock_setting"
                    android:textColor="@color/dark_txt"
                    android:textSize="@dimen/font_18"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="@dimen/margin_6"
                    android:layout_marginLeft="@dimen/margin_20"
                    android:layout_marginTop="@dimen/margin_6"
                    android:background="@color/seprator" />

                <LinearLayout
                    android:id="@+id/drop_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_10"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/margin_8"
                    android:paddingRight="@dimen/margin_8"
                    android:visibility="visible">

                    <LinearLayout
                        android:id="@+id/lay_set_pin"
                        android:layout_width="wrap_content"
                        android:layout_height="?actionBarSize"
                        android:orientation="horizontal">

                        <!--   <ImageView
                               android:layout_width="wrap_content"
                               android:layout_height="wrap_content"
                               android:layout_gravity="center"
                               android:drawablePadding="@dimen/margin_16"
                               android:src="@drawable/pattern" />-->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/set_pin_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_8"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/set_pin"
                                android:textColor="@color/tab_btn_txt"
                                android:textSize="@dimen/font_18" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/set_pin_detail"
                                android:textSize="@dimen/font_12" />
                        </LinearLayout>
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/lay_chang_pattern"
                        android:layout_width="wrap_content"
                        android:layout_height="?actionBarSize"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:drawablePadding="@dimen/margin_16"
                            android:src="@drawable/pattern" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_8"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/change_unlock"
                                android:textColor="@color/tab_btn_txt"
                                android:textSize="@dimen/font_18" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/click_change_unlock"
                                android:textSize="@dimen/font_12" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/margin_8"
                        android:background="@color/seprator" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="?actionBarSize"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:drawablePadding="@dimen/margin_16"
                            android:src="@drawable/visible" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_8"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/make_pattern_visble"
                                android:textColor="@color/tab_btn_txt"
                                android:textSize="@dimen/font_18" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:paddingLeft="@dimen/margin_8"
                                android:text="@string/draw_unlock"
                                android:textSize="@dimen/font_12" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:checked="true"
                            android:gravity="right"
                            android:textAppearance="?android:attr/textAppearanceMedium"

                            />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/margin_8"
                        android:background="@color/seprator" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="?actionBarSize"
                        android:drawableLeft="@drawable/unlock"
                        android:drawablePadding="@dimen/margin_16"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="@string/touch_vibrate"
                        android:textSize="@dimen/font_16"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>


