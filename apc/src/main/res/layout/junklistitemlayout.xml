<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_5sdp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/junklistitemimage"
            android:layout_width="?attr/actionBarSize"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginStart="@dimen/activity_horizontal_marginsmall"
            android:layout_marginLeft="@dimen/activity_horizontal_marginsmall"
            android:padding="@dimen/activity_horizontal_marginbig"
            android:src="@drawable/my_files" />

        <TextView
            android:id="@+id/junklistitemapp"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp"
            app:fontFamily="@font/roboto_regular" />

        <TextView
            android:id="@+id/junklistitemsize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_10"
            android:layout_marginRight="@dimen/margin_10"
            android:fontFamily="@font/roboto_regular"
            android:text=""
            android:textColor="@color/txt_color" />

        <LinearLayout
            android:id="@+id/checkcontainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_8">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/junklistitemcheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/custom_checkbox"
                android:checked="true"
                android:scaleX=".8"
                android:scaleY=".8" />
        </LinearLayout>
    </LinearLayout>
    <!-- <View
         android:layout_width="match_parent"
         android:layout_height="@dimen/_2sdp"
         android:background="@color/grey_50"
         android:layout_marginStart="@dimen/_2sdp"
         android:layout_marginEnd="@dimen/_2sdp"/>-->
</LinearLayout>