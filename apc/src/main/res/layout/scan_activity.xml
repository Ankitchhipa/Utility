<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:elevation="0dp"
    android:orientation="vertical"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:id="@+id/parent_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:elevation="0dp"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/layout_scan_one"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include android:id="@+id/toolbar"
            layout="@layout/main_toolbar_apc" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/error_linear"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="5"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:src="@drawable/alert" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/scan_linear"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="5"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone">

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_centerInParent="true"
                                android:indeterminate="false"
                                android:progressDrawable="@drawable/circular_progress_bar" />

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_centerInParent="true"
                                android:indeterminate="false"
                                android:progressDrawable="@drawable/circular_progress_bar_center" />

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_centerInParent="true"
                                android:indeterminate="false"
                                android:progressDrawable="@drawable/circular_progress_bar_outer" />

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true">

                                <TextView
                                    android:id="@+id/scanning_txt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:gravity="center"
                                    android:textColor="#ffffff"
                                    android:textSize="@dimen/font_17" />

                            </RelativeLayout>

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/scan_img"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_centerInParent="true"
                                app:srcCompat="@drawable/scan" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/fb_img"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true"
                                android:scaleX="1.5"
                                android:scaleY="1.5" />


                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/insta_img"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentEnd="true"
                                android:scaleX="1.5"
                                android:scaleY="1.5" />


                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/snap_img"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentBottom="true"
                                android:scaleX="1.5"
                                android:scaleY="1.5" />


                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/twitter_img"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                android:scaleX="1.5"
                                android:scaleY="1.5" />


                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/img_center_left"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:scaleX="1.5"
                                android:scaleY="1.5" />


                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/img_center_right"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:scaleX="1.5"
                                android:scaleY="1.5" />

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.advanced.phone.junk.cache.cleaner.booster.antimalware.animations.RadarScanView
                                android:id="@+id/iv_radar"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_centerInParent="true" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_fb"
                                android:layout_width="@dimen/margin_25"
                                android:layout_height="@dimen/margin_25"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_google"
                                android:layout_width="@dimen/margin_20"
                                android:layout_height="@dimen/margin_20"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentRight="true" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_yahoo"
                                android:layout_width="@dimen/margin_25"
                                android:layout_height="@dimen/margin_25"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentRight="true"
                                android:layout_alignParentBottom="true" />


                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_youtube"
                                android:layout_width="@dimen/margin_20"
                                android:layout_height="@dimen/margin_20"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentLeft="true"
                                android:layout_alignParentBottom="true" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_insta"
                                android:layout_width="@dimen/margin_20"
                                android:layout_height="@dimen/margin_20"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentRight="true"
                                android:layout_alignParentBottom="true" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_gmail"
                                android:layout_width="@dimen/margin_30"
                                android:layout_height="@dimen/margin_30"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentLeft="true"
                                android:layout_alignParentBottom="true" />
                        </RelativeLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/txt_linear"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="5"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/margin_6"
                                android:layout_marginRight="@dimen/margin_6"
                                android:layout_marginBottom="@dimen/margin_6"
                                android:ellipsize="middle"
                                android:gravity="center"
                                android:singleLine="true"
                                android:textColor="@color/text_color"
                                app:fontFamily="@font/roboto_regular" />

                            <ProgressBar
                                android:id="@+id/progressBar"
                                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/margin_24"
                                android:layout_marginRight="@dimen/margin_24"
                                android:indeterminate="false"
                                android:progress="0" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_6"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <!--  <TextView
                                      android:id="@+id/scanningFiles"
                                      android:layout_width="wrap_content"
                                      android:layout_height="wrap_content"
                                      android:layout_marginLeft="@dimen/margin_6"
                                      android:layout_marginRight="@dimen/margin_6"
                                      android:ellipsize="middle"
                                      android:singleLine="true"
                                      android:text="Scanning Files:"
                                      android:textColor="@color/txt_color"
                                      android:textSize="@dimen/font_14" />
  -->
                                <TextView
                                    android:id="@+id/malwareFileCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/margin_6"
                                    android:layout_marginRight="@dimen/margin_6"
                                    android:ellipsize="middle"
                                    android:singleLine="true"
                                    android:textColor="@color/card_orange"
                                    android:textSize="@dimen/font_16"
                                    app:fontFamily="@font/roboto_medium" />

                            </LinearLayout>


                            <TextView
                                android:id="@+id/path"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/margin_6"
                                android:layout_marginTop="@dimen/margin_6"
                                android:layout_marginRight="@dimen/margin_6"
                                android:ellipsize="middle"
                                android:gravity="center"
                                android:singleLine="true"
                                android:textColor="@color/txt_color"
                                android:textSize="@dimen/font_14"
                                app:fontFamily="@font/roboto_regular" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/mCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_12"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="@dimen/font_26"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text=""
                            android:textColor="@color/white"
                            android:textSize="@dimen/font_16"
                            android:visibility="gone" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/files_scan_linear"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="184dp"
                            android:layout_height="184dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/margin_45"
                            app:srcCompat="@drawable/ic_shield" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/margin_50"
                            android:gravity="center_horizontal"
                            android:text="@string/str_safe_apps"
                            android:textColor="@color/txt_color"
                            android:textSize="@dimen/font_20"
                            android:textStyle="bold"
                            app:fontFamily="@font/roboto_medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginLeft="@dimen/margin_10"
                            android:layout_marginTop="@dimen/margin_10"
                            android:layout_marginRight="@dimen/margin_10"
                            android:gravity="center_horizontal"
                            android:text="@string/str_recommended_scan"
                            android:textColor="@color/txt_color"
                            android:textSize="@dimen/font_13"
                            app:fontFamily="@font/roboto_regular" />

                        <androidx.legacy.widget.Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/btn_scanFiles"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/margin_45"
                            android:layout_margin="@dimen/margin_8"
                            android:background="@color/colorPrimaryDark"
                            android:text="@string/str_scan_file"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/font_16"
                            app:fontFamily="@font/roboto_medium" />

                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout_avira"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/powered_by"
                            android:textColor="@color/text_color"
                            android:textSize="@dimen/font_12"
                            app:fontFamily="@font/roboto_medium" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleX=".6"
                            android:scaleY=".6" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/avira"
                            android:textColor="@color/text_color"
                            android:textSize="@dimen/font_12"
                            app:fontFamily="@font/roboto_regular" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/retry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginLeft="@dimen/margin_40"
                        android:layout_marginRight="@dimen/margin_40"
                        android:background="@drawable/btn_white_round"
                        android:onClick="retry"
                        android:paddingTop="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"
                        android:text="@string/str_retry"
                        android:textColor="#2048A7"
                        android:textSize="@dimen/font_17"
                        android:visibility="gone"
                        app:fontFamily="@font/roboto_medium" />

                    <LinearLayout
                        android:id="@+id/ad_view_banner_container"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_55sdp"
                        android:layout_above="@id/btn_stop"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="@dimen/margin_8"
                        android:background="@drawable/ad_background"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/nativeSmallAdAntiMalware"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                    </LinearLayout>


                    <Button
                        android:id="@+id/btn_stop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/BottomButtonStyle"
                        android:text="@string/stop_scan"
                        app:fontFamily="@font/roboto_medium" />


                </LinearLayout>

                <include
                    layout="@layout/junk_bottom_sheet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_scan_two"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/sidebar_header_color"
            android:visibility="gone">

            <include layout="@layout/backpress_ads_screen" />
        </LinearLayout>

    </LinearLayout>

    <!-- <TextView
         android:id="@+id/tv_ad"
         android:layout_width="match_parent"
         android:paddingLeft="@dimen/margin_8"
         android:layout_height="0dp"
         android:background="@color/grayseperator"
         android:textSize="@dimen/font_10"
         android:layout_above="@id/ad_view_banner_container"
         android:textColor="@color/white" />-->


    <View
        android:id="@+id/margin_btm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true" />
</RelativeLayout>