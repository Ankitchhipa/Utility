<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#eaeaea"
    tools:context="com.advanced.phone.junk.cache.cleaner.booster.antimalware.frag.BottomTabFragment">

    <FrameLayout
        android:id="@+id/frame_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/linear_bottom_tab" />

    <LinearLayout
        android:id="@+id/linear_bottom_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <include layout="@layout/layout_bottom_tab" />
    </LinearLayout>
</RelativeLayout>
