            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/margin_1"
                android:layout_weight="1"
                android:background="@color/white">

                <RelativeLayout
                    android:id="@+id/rl_social_cleaner"
                    style="@style/hm_menu_bg_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/margin_2">

                    <TextView
                        android:id="@+id/tv_social"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:drawableTop="@drawable/social_cleaner"
                        android:drawablePadding="@dimen/margin_10"
                        android:gravity="center"
                        android:text="@string/str_turbo_cleaner"
                        android:textAllCaps="true"
                        android:textColor="@color/text_color"
                        android:textSize="@dimen/_9ssp"
                        android:fontFamily="@font/roboto_regular" />

                    <ImageView
                        android:id="@+id/arrow_blink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerInParent="true"
                        android:src="@drawable/arrow_lock"
                        android:visibility="gone" />
                </RelativeLayout>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/white">

                <RelativeLayout
                    android:id="@+id/rl_similar_photos"
                    style="@style/hm_menu_bg_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/margin_2">

                    <TextView
                        android:id="@+id/tv_duplicate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:drawableTop="@drawable/similar_photo"
                        android:drawablePadding="@dimen/margin_10"
                        android:gravity="center"
                        android:text="@string/str_duplicate"
                        android:textAllCaps="true"
                        android:textColor="@color/text_color"
                        android:textSize="@dimen/_9ssp"
                        android:fontFamily="@font/roboto_regular" />
                </RelativeLayout>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/appmanager_btn_hm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/margin_1"
                android:layout_weight="1"
                android:background="@color/white"
                android:visibility="gone">

                <RelativeLayout
                    android:id="@+id/rl_appmanager"
                    style="@style/hm_menu_bg_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:drawableTop="@drawable/app_manager_icon_hm"
                        android:drawablePadding="@dimen/margin_10"

                        android:gravity="center"
                        android:text="@string/str_app_manager"
                        android:textAllCaps="true"
                        android:textColor="@color/text_color"
                        android:textSize="@dimen/font_11" />
                </RelativeLayout>
            </RelativeLayout>

