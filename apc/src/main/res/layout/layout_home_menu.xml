                 android:background="@color/white"
                 android:visibility="gone">

                 <RelativeLayout
                     android:id="@+id/rl_phone_boost"
                     style="@style/hm_menu_bg_ripple"
                     android:layout_width="match_parent"
                     android:layout_height="match_parent"
                     android:padding="@dimen/margin_2"

                     android:clickable="true"
                     android:focusable="true">

                     <TextView
                         android:id="@+id/tv_boost"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:layout_centerInParent="true"
                         android:drawableTop="@drawable/ic_phone_boost"
                         android:drawablePadding="@dimen/margin_10"

                         android:gravity="center"
                         android:text="@string/str_phone_boost_small"
                         android:textAllCaps="true"
                         android:textColor="@color/text_color"
                         android:textSize="@dimen/font_11" />
                 </RelativeLayout>
             </RelativeLayout>-->

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/white">

                <RelativeLayout
                    android:id="@+id/rl_secure_browsing"
                    style="@style/hm_menu_bg_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/margin_2">

                    <TextView
                        android:id="@+id/tv_antivirus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:drawableTop="@drawable/ic_security"
                        android:drawablePadding="@dimen/margin_10"
                        android:gravity="center"
                        android:text="@string/str_anti_virus"
                        android:textAllCaps="true"
                        android:textColor="@color/text_color"
                        android:textSize="@dimen/_9ssp"
                        android:fontFamily="@font/roboto_regular" />
                </RelativeLayout>
            </RelativeLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/view_horizontal_bg_gradient" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- <RelativeLayout
                 android:layout_width="match_parent"
                 android:layout_height="match_parent"
                 android:layout_weight="1"
                 android:background="@color/white"
                 android:visibility="gone">


                 <RelativeLayout
                     android:id="@+id/rl_battery_saver"
                     style="@style/hm_menu_bg_ripple"
                     android:layout_width="match_parent"
                     android:layout_height="match_parent"
                     android:clickable="true"
                     android:focusable="true"
                     android:padding="@dimen/margin_2">

                     <TextView
                         android:id="@+id/tv_battary"
