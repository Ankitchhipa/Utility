    <LinearLayout
        android:id="@+id/linear_bottom_layer"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/view_vertical_bg_gradient"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginRight="@dimen/margin_1"
                android:background="@color/white">

                <RelativeLayout
                    android:id="@+id/rl_junk_cleaner"
                    style="@style/hm_menu_bg_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/margin_2">

                    <TextView
                        android:id="@+id/tv_junk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:drawableTop="@drawable/ic_junk_cleaner"
                        android:drawablePadding="@dimen/margin_10"
                        android:gravity="center"
                        android:text="@string/str_junk_title"
                        android:textAllCaps="true"
                        android:textColor="@color/text_color"
                        android:textSize="@dimen/_9ssp"
                        android:fontFamily="@font/roboto_regular"
                        android:transitionName="header" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/tv_junk"
                        android:layout_alignEnd="@+id/tv_junk"
                        android:layout_alignRight="@+id/tv_junk"
                        android:layout_marginTop="-10dp"
                        android:background="@drawable/btn_red_round"

                        android:paddingLeft="@dimen/margin_6"
                        android:paddingTop="@dimen/margin_4"
                        android:paddingRight="@dimen/margin_6"
                        android:paddingBottom="@dimen/margin_4"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="@dimen/font_9"
                        android:visibility="gone" />
                </RelativeLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/view_vertical_bg_gradient"
                    android:rotation="180" />

            </RelativeLayout>


            <!-- <RelativeLayout
                 android:layout_width="match_parent"
                 android:layout_height="match_parent"
                 android:layout_marginLeft="@dimen/margin_1"
                 android:layout_marginRight="@dimen/margin_1"
