    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/divider_shadow"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/margin_15"
                android:paddingLeft="@dimen/margin_15"
                android:paddingTop="@dimen/margin_15"
                android:paddingEnd="@dimen/margin_15"
                android:paddingRight="@dimen/margin_15"
                android:paddingBottom="@dimen/margin_15"
                android:text="@string/str_no_duplicate"
                android:textColor="@color/txt_color"
                app:fontFamily="@font/roboto_regular" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/activity_horizontal_marginsmall"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_horizontal_marginsmall"
                    android:layout_marginBottom="@dimen/activity_horizontal_marginsmall"
                    android:gravity="center"
                    android:text="@string/str_matchingleab"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/txt_color" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/gray"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:orientation="horizontal"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btn_seekminus1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:src="@drawable/minus" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/line5"
                    android:gravity="center">

                    <SeekBar
                        android:id="@+id/settings_seekbar1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_seekplus1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="10dp"
                    android:background="@null"
                    android:src="@drawable/plus" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_24"
                android:layout_marginTop="@dimen/margin_15"
                android:includeFontPadding="false"
                android:text="@string/str_scantype"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/txt_color"
                android:textSize="@dimen/font_18"
                app:fontFamily="@font/roboto_medium" />

            <!--<View-->
            <!--android:layout_width="match_parent"-->
            <!--android:layout_height="0.5dp"-->
            <!--android:background="@color/gray" />-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white">

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_8">

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbtn_camera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/activity_horizontal_marginbig"
                        android:checked="true"
                        android:paddingTop="@dimen/activity_horizontal_marginbig"
                        android:paddingBottom="@dimen/activity_horizontal_marginbig"
                        android:text="@string/str_camera"
                        android:textColor="@color/txt_color"
                        app:buttonTint="@color/colorPrimaryDark"
                        app:fontFamily="@font/roboto_regular" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.7dp"
                        android:background="@color/gray" />


                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbtn_all"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/activity_horizontal_marginbig"
                        android:buttonTint="@color/colorPrimaryDark"
                        android:checked="false"
                        android:paddingTop="@dimen/activity_horizontal_marginbig"
                        android:paddingBottom="@dimen/activity_horizontal_marginbig"
                        android:text="@string/str_all_photos"
                        android:textColor="@color/txt_color"
                        app:fontFamily="@font/roboto_regular" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.7dp"
                        android:background="@color/gray" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbtn_folder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/activity_horizontal_marginbig"
                        android:checked="false"
                        android:paddingTop="@dimen/activity_horizontal_marginbig"
                        android:paddingBottom="@dimen/activity_horizontal_marginbig"
                        android:text="@string/str_select_folder"
                        android:textColor="@color/txt_color"
                        app:buttonTint="@color/colorPrimaryDark"
                        app:fontFamily="@font/roboto_regular" />
                </RadioGroup>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ad_view_banner_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_55sdp"
            android:layout_above="@id/btnRescan"
            android:layout_margin="@dimen/margin_8"
            android:background="@drawable/ad_background"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/nativeSmallAdNoDuplicate"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <Button
            android:id="@+id/btnRescan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="scanClick"
            android:text="@string/str_re_scan"
            style="@style/BottomButtonStyle"
            app:fontFamily="@font/roboto_medium" />
    </LinearLayout>

</LinearLayout>