<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:id="@+id/layout_one"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/app_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!--<android.support.design.widget.AppBarLayout-->
            <!--android:id="@+id/app_layout"-->
            <!--android:layout_width="match_parent"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">-->

            <!--<androidx.appcompat.widget.Toolbar-->
            <!--android:id="@+id/toolbar"-->
            <!--android:layout_width="match_parent"-->
            <!--android:layout_height="?attr/actionBarSize"-->
            <!--android:background="@color/sidebar_header_color"-->
            <!--app:layout_scrollFlags="scroll|enterAlways"-->
            <!--app:popupTheme="@style/ThemeOverlay.AppCompat.Light"-->
            <!--app:titleTextColor="@color/text_color" />-->
            <include android:id="@+id/toolbar"
                layout="@layout/main_toolbar_apc" />

            <LinearLayout
                android:id="@+id/juncscreen_toplayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/toolbar"
                android:background="@color/sidebar_header_color"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="@dimen/margin_8">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/junkdisplay_sizetv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/colorPrimaryDark"
                        app:fontFamily="@font/roboto_medium" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_4"
                        android:layout_marginBottom="@dimen/margin_4">

                        <TextView
                            android:id="@+id/junkdisplay_sizetv_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_2"
                            android:layout_marginLeft="@dimen/margin_2"
                            app:fontFamily="@font/roboto_medium"
                            android:textColor="@color/txt_color" />

                        <TextView
                            android:id="@+id/symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/junkdisplay_sizetv_unit"
                            android:layout_alignParentStart="true"
                            android:layout_marginStart="0dp"
                            android:text=""
                            app:fontFamily="@font/roboto_medium"
                            android:textColor="@color/txt_color" />
                    </RelativeLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/junkdisplay_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_space_optimized"
                    android:textColor="@color/text_color"
                    app:fontFamily="@font/roboto_regular"
                    android:textSize="@dimen/font_17" />

            </LinearLayout>
            <LinearLayout
                android:id="@+id/ad_view_banner_container"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/ad_background"
                android:layout_margin="@dimen/margin_8"
                android:layout_below="@id/juncscreen_toplayout"
                android:layout_height="@dimen/_55sdp">

                <FrameLayout
                    android:id="@+id/nativeSmallAdMediaTab"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

            </LinearLayout>


            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ad_view_banner_container"
                android:background="@color/sidebar_header_color"
                app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
                app:tabContentStart="@dimen/image_width"
                app:tabTextColor="@color/black"
                app:tabMode="scrollable" />

            <!--</android.support.design.widget.AppBarLayout>-->
        </RelativeLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/_10sdp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />


        <LinearLayout
            android:id="@+id/relative_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">



            <Button
                android:id="@+id/btncleannow"
                android:layout_width="match_parent"
                style="@style/BottomButtonStyle"
                android:layout_height="wrap_content"
                android:text="@string/str_clean"
                app:fontFamily="@font/roboto_medium"
                android:textSize="@dimen/font_18" />


            <include
                layout="@layout/btm_ads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!--<ImageView-->
        <!--android:layout_width="wrap_content"-->
        <!--android:layout_height="?attr/actionBarSize"-->
        <!--android:padding="@dimen/margin_15"-->
        <!--android:src="@drawable/ic_back" />-->
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/layout_two"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="@color/sidebar_header_color"
        android:visibility="gone">

        <include layout="@layout/backpress_ads_screen" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layout_three"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="@color/sidebar_header_color"
        android:visibility="gone">

        <include layout="@layout/backpress_ads_screen_deletion" />
    </RelativeLayout>

</RelativeLayout>