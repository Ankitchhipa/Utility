<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:showIn="@layout/activity_cpu_cooler_animation">

    <RelativeLayout
        android:id="@+id/top_layo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">

        <ImageView
            android:id="@+id/scan_before"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerInParent="true"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/scan_after"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerInParent="true"
            android:visibility="gone" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:src="@drawable/cpu_scanning" />

        <ImageView
            android:id="@+id/scan_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:src="@drawable/scanning_line" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/text_scanning"
        android:layout_marginTop="@dimen/margin_4"

        android:gravity="center"
        android:text="@string/str_cpu_cooler_scan"
        android:textColor="@color/txt_color"
        android:textSize="@dimen/font_16" />

    <TextView
        android:id="@+id/text_scanning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/top_layo"
        android:layout_marginTop="@dimen/margin_20"

        android:gravity="center"
        android:text=" "
        android:textColor="@color/txt_color"
        android:textSize="@dimen/font_22"
        android:textStyle="bold" />


    <!--<ImageView-->
    <!--android:layout_width="wrap_content"-->
    <!--android:layout_height="wrap_content"-->
    <!--android:layout_marginBottom="@dimen/margin_8" />-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:orientation="vertical">

        <!--<include layout="@layout/btm_ads_scanning" />-->
        <include layout="@layout/btm_ads_scanning" />

    </LinearLayout>

</RelativeLayout>
