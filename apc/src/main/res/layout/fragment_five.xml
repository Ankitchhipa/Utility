<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/parent_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/linear_mid_layer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:background="@drawable/divider_shadow"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/margin_16"
                android:paddingTop="@dimen/margin_8"
                android:paddingEnd="@dimen/margin_12"
                android:paddingBottom="@dimen/margin_8">

                <TextView
                    android:id="@+id/tv_social_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:textSize="@dimen/font_16" />

                <TextView
                    android:id="@+id/tv_social_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="@dimen/margin_8"
                    android:layout_toStartOf="@+id/checkAll_doc"
                    android:textSize="@dimen/font_16" />

                <CheckBox
                    android:id="@+id/checkAll_doc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:button="@drawable/custom_checkbox"
                    android:checked="false"
                    android:clickable="false"
                    android:focusable="false" />

            </RelativeLayout>
        </LinearLayout>

        <com.advanced.phone.junk.cache.cleaner.booster.antimalware.utility.SocialGridView
            android:id="@+id/rv_docadapter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/linear_mid_layer"
            android:adjustViewBounds="true"
            android:drawSelectorOnTop="true"
            android:focusable="false"
            android:gravity="center"
            android:horizontalSpacing="@dimen/margin_1"
            android:numColumns="1"
            android:scrollbarStyle="outsideOverlay" />
    </RelativeLayout>

    <TextView
        android:id="@+id/hidden_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="@string/str_no_record"
        android:visibility="gone" />
</RelativeLayout>
