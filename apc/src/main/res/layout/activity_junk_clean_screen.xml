<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@android:color/white">

    <RelativeLayout
        android:id="@+id/layout_one"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/tv_ad">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/sidebar_header_color"
                android:orientation="vertical">

                <include
                    android:id="@+id/toolbar"
                    layout="@layout/main_toolbar_apc" />

                <LinearLayout
                    android:id="@+id/juncscreen_toplayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/margin_15">


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/junkdisplay_sizetv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="0"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="@dimen/_11ssp"
                            app:fontFamily="@font/roboto_medium" />

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_4"
                            android:layout_marginBottom="@dimen/margin_4">

                            <TextView
                                android:id="@+id/junkdisplay_sizetv_unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_2"
                                android:includeFontPadding="false"
                                android:text="@string/str_mb"
                                android:textColor="@color/txt_color"
                                android:textSize="@dimen/_11ssp"
                                app:fontFamily="@font/roboto_medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/junkdisplay_sizetv_unit"
                                android:includeFontPadding="false"
                                android:text=""
                                android:textColor="@color/txt_color" />
                        </RelativeLayout>


                    </LinearLayout>


                    <TextView
                        android:id="@+id/junkdisplay_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_junk_found"
                        android:textColor="@color/text_color"
                        android:textSize="@dimen/_14ssp"
                        android:includeFontPadding="false"
                        app:fontFamily="@font/roboto_regular" />

                </LinearLayout>

            </LinearLayout>

            <include layout="@layout/content_junk_delete_screen" />


        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layout_two"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:visibility="gone">

        <include layout="@layout/backpress_ads_screen" />
    </RelativeLayout>

    <!-- <TextView
         android:id="@+id/tv_ad"
         android:layout_width="match_parent"
         android:paddingLeft="@dimen/margin_8"
         android:layout_height="0dp"
         android:background="@color/grayseperator"
         android:textSize="@dimen/font_10"
         android:textColor="@color/white" />



     <View
         android:id="@+id/margin_btm"
         android:layout_width="match_parent"
         android:layout_height="0dp"
         android:layout_alignParentBottom="true" />-->
</RelativeLayout>