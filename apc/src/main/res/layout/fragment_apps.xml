<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_emptybackup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="?attr/actionBarSize"
        android:gravity="center"
        android:text="@string/str_noappfound"
        android:textStyle="bold"
        android:visibility="gone"
        app:fontFamily="@font/roboto_medium" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rviewapps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="?attr/actionBarSize"></androidx.recyclerview.widget.RecyclerView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="@color/white"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/app_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_weight="1"
            android:background="@drawable/round_btn_bg"
            android:gravity="center"
            android:paddingVertical="@dimen/_7sdp"
            android:text="@string/str_backup"
            android:textColor="@color/white"
            android:textSize="@dimen/font_18"
            app:fontFamily="@font/roboto_medium" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/app_uninstall"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_43"
            android:layout_marginStart="@dimen/margin_8"
            android:layout_weight="1"
            android:background="@drawable/rounded_drawable_red"
            android:gravity="center"
            android:paddingVertical="@dimen/_7sdp"
            android:text="@string/str_unistall"
            android:textColor="@color/white"
            android:textSize="@dimen/font_18"
            app:fontFamily="@font/roboto_medium" />

    </LinearLayout>
</RelativeLayout>