<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_drawable_gamebooster"
    android:orientation="horizontal"
    android:padding="@dimen/margin_6">

    <TextView
        android:id="@+id/popupunistall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_4"
        android:layout_marginRight="@dimen/margin_6"
        android:layout_marginLeft="@dimen/margin_4"

        android:textStyle="bold"
        android:text="@string/str_unistall"
        android:textSize="@dimen/font_14"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:layout_marginEnd="@dimen/margin_6"
        android:layout_marginStart="@dimen/margin_4" />

    <TextView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:paddingRight="@dimen/margin_4"
        android:paddingLeft="@dimen/margin_4"
        android:background="@color/white"
        android:padding="@dimen/activity_horizontal_marginsmall" />

    <TextView
        android:id="@+id/popupremove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/activity_horizontal_marginsmall"
        android:textSize="@dimen/font_14"
        android:layout_marginRight="@dimen/margin_4"
        android:layout_marginLeft="@dimen/margin_6"
        android:text="@string/str_remove"

        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginEnd="@dimen/margin_4"
        android:layout_marginStart="@dimen/margin_6" />
</LinearLayout>