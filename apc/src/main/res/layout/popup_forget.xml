<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_lay"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/lay_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/btn"
        android:layout_gravity="center">

        <LinearLayout
            android:id="@+id/lay_one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/margin_8">

            <ImageView
                android:id="@+id/forget_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/forget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingLeft="@dimen/margin_12"
                android:text="@string/app_name"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/margin_18" />
        </LinearLayout>

        <TextView
            android:id="@+id/forget_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingLeft="@dimen/margin_16"
            android:text="@string/forget_password"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="@dimen/margin_16" />

        <LinearLayout
            android:id="@+id/lay_three"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/margin_8">

            <Button
                android:id="@+id/forget_btn_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_2"
                android:layout_weight="1"
                android:background="@drawable/btn"
                android:elevation="@dimen/margin_6"
                android:text="@string/no"
                android:textColor="@color/colorPrimaryDark" />

            <Button
                android:id="@+id/forget_btn_yes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_2"
                android:layout_weight="1"
                android:background="@drawable/btn"
                android:elevation="@dimen/margin_6"
                android:text="@string/yes"
                android:textColor="@color/colorPrimaryDark" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>