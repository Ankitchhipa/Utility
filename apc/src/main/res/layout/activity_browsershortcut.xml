<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark"
    android:paddingLeft="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_vertical_margin"
    tools:context="com.advanced.phone.junk.cache.cleaner.booster.antimalware.shortcutmodules.BrowserActivityShortcut">

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:paddingTop="@dimen/margin_8"
        android:paddingBottom="@dimen/margin_8"
        android:visibility="gone"
        android:paddingRight="@dimen/margin_8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="?attr/actionBarSize">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/private_browser" />

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_16"

            android:gravity="center"
            android:text="@string/str_private_browsing"
            android:textColor="@color/white"
            android:textSize="@dimen/font_18" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_20"
            android:background="@drawable/edittext_backround"
            android:padding="@dimen/margin_6">

            <ImageView
                android:id="@+id/imgSea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:padding="@dimen/margin_6"
                android:src="@drawable/sidebar_icon_2" />

            <EditText
                android:id="@+id/edittextSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/imgSea"
                android:background="#00000000"
                android:ems="10"

                android:hint="@string/str_search_url"
                android:imeOptions="actionSearch"
                android:inputType="textWebEmailAddress"
                android:layout_marginLeft="@dimen/margin_10"
                android:singleLine="true"
                android:textSize="@dimen/font_16" />
        </RelativeLayout>

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_20"

            android:gravity="center"
            android:text="@string/str_browsing"
            android:textColor="@color/white"
            android:textSize="@dimen/font_14" />

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10"

            android:gravity="center"
            android:text="@string/str_browser"
            android:textColor="@color/white"
            android:textSize="@dimen/font_14" />
    </LinearLayout>

</RelativeLayout>
