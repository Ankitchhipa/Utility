<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:gravity="center"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/shield"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/safe" />


            <!--<android.support.v7.widget.AppCompatImageView-->
            <!--android:id="@+id/imageView"-->
            <!--android:layout_width="wrap_content"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:layout_centerInParent="true"-->
            <!--android:scaleType="fitXY"-->
            <!--app:srcCompat="@drawable/animated_tick" />-->

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/fb_img"
                android:layout_width="@dimen/margin_25"
                android:layout_height="@dimen/margin_25"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/insta_img"
                android:layout_width="@dimen/margin_25"
                android:layout_height="@dimen/margin_25"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:scaleX="-1" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/snap_img"
                android:layout_width="@dimen/margin_25"
                android:layout_height="@dimen/margin_25"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"
                android:rotation="300" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/twitter_img"
                android:layout_width="@dimen/margin_25"
                android:layout_height="@dimen/margin_25"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                android:alpha="0.5"
                android:rotation="45"
                android:scaleX="-1" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_center_left"
                android:layout_width="@dimen/margin_25"
                android:layout_height="@dimen/margin_25"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:alpha="0.5"
                android:rotation="335" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_center_right"
                android:layout_width="@dimen/margin_25"
                android:layout_height="@dimen/margin_25"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:alpha="0.8"
                android:rotation="30"
                android:scaleX="-1" />

            <TextView
                android:id="@+id/textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/shield"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_45"
                android:gravity="center"
                android:text="@string/str_av_protected"
                android:textColor="@color/txt_color"
                android:includeFontPadding="false"
                android:textSize="@dimen/_14ssp"
                app:fontFamily="@font/roboto_medium" />
        </RelativeLayout>

    </LinearLayout>

    <View
        android:id="@+id/margin_btm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true" />
</LinearLayout>
