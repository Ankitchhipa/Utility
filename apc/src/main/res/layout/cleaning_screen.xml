<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout_scan_one"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/main_toolbar_apc" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#eaf6ff"
            android:orientation="vertical">

            <LinearLayout

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/issues_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="@dimen/_39ssp"
                    app:fontFamily="@font/roboto_medium" />

                <TextView
                    android:id="@+id/mediadisplay_sizetv_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin_2"
                    android:text="@string/str_threats"
                    android:textColor="@color/white"
                    android:textSize="@dimen/font_14"
                    android:visibility="gone"
                    app:fontFamily="@font/roboto_medium" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/_12ssp"
                android:includeFontPadding="false"
                android:text="@string/str_critical_issues"
                android:textColor="@color/card_orange"
                android:textSize="@dimen/font_18"
                app:fontFamily="@font/roboto_medium" />
        </LinearLayout>


        <ExpandableListView
            android:id="@+id/result_lv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:animateLayoutChanges="true"
            android:background="@android:color/white"
            android:groupIndicator="@null"
            android:scrollbars="none" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ad_view_banner_container"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_55sdp"
                android:layout_above="@id/fix"
                android:layout_margin="@dimen/margin_8"
                android:background="@drawable/ad_background"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/nativeSmallAdScanResult"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </LinearLayout>

            <Button
                android:id="@+id/fix"
                style="@style/BottomButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_fix_now"
                app:fontFamily="@font/roboto_medium" />


        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_scan_two"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="@color/sidebar_header_color"
        android:orientation="vertical"
        android:visibility="gone">

        <include layout="@layout/backpress_ads_screen" />
    </LinearLayout>
</LinearLayout>