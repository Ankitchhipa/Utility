<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?android:attr/actionBarSize"
    android:background="@android:color/white"
    android:gravity="center"
    android:paddingHorizontal="@dimen/_5sdp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/junklistitemimage"
        android:layout_width="?android:attr/actionBarSize"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/margin_4" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/junklistitemapp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:marqueeRepeatLimit="marquee_forever"
            android:paddingStart="5dp"
            android:singleLine="true"
            android:text=""
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/txt_color" />

        <TextView
            android:id="@+id/junklistitemsize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:paddingStart="@dimen/margin_5"
            android:text="check"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/txt_color" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/listiteminfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_2"
        app:srcCompat="@drawable/ic_info" />

    <LinearLayout
        android:id="@+id/checkcontainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_3"
        android:padding="@dimen/activity_horizontal_marginbig">

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/junklistitemcheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/custom_checkbox"
            android:checked="true" />
    </LinearLayout>
</LinearLayout>