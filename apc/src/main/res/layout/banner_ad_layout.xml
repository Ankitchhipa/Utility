<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:padding="@dimen/margin_2"
    android:layout_height="?android:attr/actionBarSize"
    android:background="@drawable/border">

    <RelativeLayout
        android:id="@+id/parent_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/img_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/margin_1"
            android:visibility="visible"
            android:layout_alignParentRight="true"
            android:translationZ="@dimen/margin_8"
            android:src="@drawable/info_icon"
            android:background="@color/white"></ImageView>

        <TextView
            android:id="@+id/tv_ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/margin_1"
            android:layout_gravity="left|top"
            android:text="AD"
            android:textSize="@dimen/font_10"
            android:textColor="@color/black"
            android:paddingLeft="@dimen/margin_1"
            android:paddingRight="@dimen/margin_1"
            android:paddingTop="0.5dp"
            android:paddingBottom="0.5dp"
            android:translationZ="@dimen/margin_2"
            android:background="@color/white"></TextView>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="?android:attr/actionBarSize">

            <ImageView
                android:id="@+id/img_app_logo"
                android:layout_width="?android:attr/actionBarSize"
                android:padding="4dp"
                android:layout_height="?android:attr/actionBarSize" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="2dp"
                android:gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_appname"
                    android:layout_width="match_parent"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_height="wrap_content"
                    android:text="" />

                <TextView
                    android:id="@+id/tv_app_desc"
                    android:layout_width="match_parent"
                    android:textSize="@dimen/font_12"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_height="wrap_content"
                    android:text="" />
            </LinearLayout>

            <TextView
                android:id="@+id/appinstall_call_to_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="right"
                android:layout_marginRight="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_8"
                android:text=""
                android:textAllCaps="true"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/font_14"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>