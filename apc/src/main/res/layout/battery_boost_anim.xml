<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sidebar_header_color">

    <com.advanced.phone.junk.cache.cleaner.booster.antimalware.animations.GravView
        android:id="@+id/grav_full"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        app:animationGenerators="@array/BallWaveAnimations"
        app:array_colors="@array/Spectral"
        app:ball_size="3dp"
        app:ball_size_from_size="3dp"
        app:ball_size_to_size="6dp"
        app:colorGenerator="com.advanced.phone.junk.cache.cleaner.booster.antimalware.batteryanim.ArrayColorGenerator"
        app:gravGenerator="com.advanced.phone.junk.cache.cleaner.booster.antimalware.batteryanim.BallGenerator"
        app:pointGenerator="com.advanced.phone.junk.cache.cleaner.booster.antimalware.batteryanim.RegularPointGenerator"
        app:regular_cell_size="400"
        app:regular_variance="500"
        app:shake_direction="horizontal"
        app:shake_variance="50dp"
        app:side_to_side_direction="downToUp"
        app:side_to_side_max_duration="5000"
        app:side_to_side_min_duration="4000" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon_insta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="invisible"
        android:layout_centerHorizontal="true"
        app:srcCompat="@drawable/ic_android" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon_fb"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:srcCompat="@drawable/ic_android" />


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon_whtsapp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        app:srcCompat="@drawable/ic_android"
        android:layout_alignParentEnd="true" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon_snap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="invisible"
        app:srcCompat="@drawable/no" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon_twitter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="invisible"
        android:layout_alignParentRight="true"
        android:src="@drawable/ic_android"
        android:layout_alignParentEnd="true" />

    <com.advanced.phone.junk.cache.cleaner.booster.antimalware.waveview.WaveView
        android:id="@+id/wave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:background="@color/white" />

    <com.advanced.phone.junk.cache.cleaner.booster.antimalware.animations.GravView
        android:id="@+id/grav"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        app:animationGenerators="@array/BallWaveAnimations"
        app:array_colors="@array/Spectral"
        app:ball_size="2dp"
        app:ball_size_from_size="2dp"
        app:ball_size_to_size="4dp"
        app:colorGenerator="com.advanced.phone.junk.cache.cleaner.booster.antimalware.batteryanim.ArrayColorGenerator"
        app:gravGenerator="com.advanced.phone.junk.cache.cleaner.booster.antimalware.batteryanim.BallGenerator"
        app:pointGenerator="com.advanced.phone.junk.cache.cleaner.booster.antimalware.batteryanim.RegularPointGenerator"
        app:regular_cell_size="50"
        app:regular_variance="100"
        app:shake_direction="horizontal"
        app:shake_variance="50dp"
        app:side_to_side_direction="downToUp"
        app:side_to_side_max_duration="1000"
        app:side_to_side_min_duration="2000" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:src="@drawable/battery_anim" />
</RelativeLayout>

