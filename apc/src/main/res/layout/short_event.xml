<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/sidebar_header_color"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/activity_horizontal_marginsmall"
        android:layout_marginTop="@dimen/activity_horizontal_marginsmall"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/t_one"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight=".18"
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/txt_color"
            android:paddingBottom="@dimen/margin_16"
            android:paddingTop="@dimen/margin_16" />

        <TextView
            android:id="@+id/t_two"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".18"
            android:drawablePadding="@dimen/margin_3"
            android:ellipsize="end"

            android:gravity="center"
            android:text="@string/str_boostt"
            android:textColor="@color/txt_color"
            android:textSize="@dimen/font_11" />

        <TextView
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/txt_color"
            android:paddingBottom="@dimen/margin_16"
            android:paddingTop="@dimen/margin_16" />

        <!--<TextView
            android:id="@+id/t_six"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".18"
            android:drawablePadding="@dimen/margin_3"
            android:ellipsize="end"

            android:gravity="center"
            android:text="@string/str_cpu_cooler"
            android:textColor="@color/txt_color"
            android:textSize="@dimen/font_11" />-->


        <TextView
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/txt_color"
            android:paddingBottom="@dimen/margin_16"
            android:paddingTop="@dimen/margin_16" />

        <TextView
            android:id="@+id/t_four"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".18"
            android:drawablePadding="@dimen/margin_3"
            android:ellipsize="end"

            android:gravity="center"
            android:text="@string/str_boostt"
            android:textColor="@color/txt_color"
            android:textSize="@dimen/font_11" />


        <TextView
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/txt_color"
            android:paddingBottom="@dimen/margin_16"
            android:paddingTop="@dimen/margin_16" />

        <TextView
            android:id="@+id/t_five"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".18"
            android:drawablePadding="@dimen/margin_3"
            android:ellipsize="end"

            android:gravity="center"
            android:text="@string/str_anti_virus"
            android:textColor="@color/txt_color"
            android:textSize="@dimen/font_11" />

        <TextView
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/txt_color"
            android:paddingBottom="@dimen/margin_16"
            android:paddingTop="@dimen/margin_16" />

        <TextView
            android:id="@+id/t_three"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".18"
            android:drawablePadding="@dimen/margin_3"
            android:ellipsize="end"

            android:gravity="center"
            android:text="@string/str_boostt"
            android:textColor="@color/txt_color"
            android:textSize="@dimen/font_11" />
    </LinearLayout>

</LinearLayout>
